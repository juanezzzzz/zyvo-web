---
// Plantilla de las páginas legales (privacidad y términos): texto largo, fácil de leer.
import { ArrowLeft } from '@lucide/astro';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { legal } from '../data/site';
interface Props { title: string; description: string; lead: string }
const { title, description, lead } = Astro.props;
---
<Base title={`${title} | Zyvo Solutions`} description={description}>
  <Header />
  <main id="main" class="bg-carbon pt-[4.5rem]">
    <article class="wrap grid gap-12 py-12 md:py-20 lg:grid-cols-12">
      <header class="min-w-0 lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <a href={url()} class="inline-flex min-h-11 items-center gap-2 rounded-md text-sm text-niebla-2 transition-colors hover:text-marfil">
            <ArrowLeft size={16} aria-hidden="true" /> Volver al inicio
          </a>
          <h1 class="display mt-6 text-[clamp(2.2rem,5vw,3.6rem)] leading-[1.02]">{title}</h1>
          <p class="lede mt-5">{lead}</p>
          <p class="mt-6 text-sm text-niebla">Vigente desde el {legal.vigencia}.</p>
        </div>
      </header>
      <div class="case-prose legal min-w-0 lg:col-span-7 lg:col-start-6">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  .legal h3 { margin-top: 1.6em; font-weight: 700; font-stretch: 118%; color: var(--color-marfil); }
  .legal dl { display: grid; gap: .35em 1.5em; grid-template-columns: max-content 1fr; }
  .legal dt { color: var(--color-niebla); }
  .legal dd { color: var(--color-marfil); overflow-wrap: anywhere; }
  @media (max-width: 480px) { .legal dl { grid-template-columns: 1fr; } .legal dd { margin-bottom: .5em; } }
</style>
