---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Audiences from '../components/Audiences.astro';
import Projects from '../components/Projects.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-azul focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
  <Header />
  <main id="main">
    <Hero />
    <Audiences />
    <Projects />
    <HowWeWork />
    <Team />
    <Contact />
  </main>
  <Footer />
</Base>
