---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowRight, ArrowUpRight, Trophy, MessageCircle } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCover from '../../components/ProjectCover';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { getProjects } from '../../lib/get-projects';
import { accents } from '../../lib/projects';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('proyectos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = await getProjects();
const i = all.findIndex((p) => p.slug === entry.id);
const p = all[i];
const next = all[(i + 1) % all.length];
const c = accents[p.accent];
---
<Base title={`${p.name} | Caso de ${site.name}`} description={p.summary} image={`og/${p.slug}.png`}>
  <Header />
  <main id="main" class="bg-carbon pt-[4.5rem]">
    <article>
      <header class="wrap pt-10 md:pt-16">
        <a href={url('/#proyectos')} class="inline-flex min-h-11 items-center gap-2 rounded-md text-sm text-niebla-2 transition-colors hover:text-marfil">
          <ArrowLeft size={16} aria-hidden="true" /> Todos los proyectos
        </a>
        <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="min-w-0 lg:col-span-8">
            <p class="text-niebla-2">{p.kind}</p>
            <h1 class="display mt-3 text-[clamp(2.6rem,7vw,6rem)] leading-[0.98]" translate="no">{p.name}</h1>
            <p class="lede mt-6 max-w-[58ch]">{p.summary}</p>
          </div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/10 pt-6 sm:grid-cols-3 lg:col-span-4 lg:grid-cols-1 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
            {p.facts.map((f) => (
              <div>
                <dt class="text-sm text-niebla">{f.k}</dt>
                <dd class="mt-0.5 font-semibold">{f.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </header>

      <div class="wrap mt-12 md:mt-16">
        {p.video ? (
          <div class="overflow-hidden rounded-xl border border-white/10" style={`view-transition-name: cover-${p.slug}`}>
            <VideoPlayer {...p.video} eager />
          </div>
        ) : (
        <div class="relative aspect-[16/9] overflow-hidden rounded-xl border border-white/10 md:aspect-[21/9]" style={`view-transition-name: cover-${p.slug}`}>
          <ProjectCover p={p} large />
          {p.highlight && (
            <span class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-md bg-senal px-3 py-1.5 text-sm font-semibold text-carbon md:bottom-6 md:left-6">
              <Trophy size={16} aria-hidden="true" /> {p.highlight}
            </span>
          )}
        </div>
        )}
      </div>

      <div class="wrap grid gap-14 py-16 md:py-24 lg:grid-cols-12">
        <aside class="min-w-0 lg:col-span-4">
          <div class="grid gap-10 lg:sticky lg:top-28">
            <section>
              <h2 class="font-semibold">En resumen</h2>
              <ul class="mt-4 grid gap-3 text-niebla-2">
                {p.bullets.map((b) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.6em] h-1.5 w-3 shrink-0 -skew-y-[30deg]" style={`background:${c}`} aria-hidden="true"></span>{b}
                  </li>
                ))}
              </ul>
            </section>
            <section>
              <h2 class="font-semibold">Tecnologías</h2>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.stack.map((t) => <li class="rounded bg-acero px-2.5 py-1 font-mono text-[13px] text-niebla-2 sm:text-xs">{t}</li>)}
              </ul>
            </section>
            {p.links.length > 0 && (
              <div class="flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="btn-ghost">{l.label} <ArrowUpRight size={16} aria-hidden="true" /></a>
                ))}
              </div>
            )}
          </div>
        </aside>

        <div class="case-prose min-w-0 lg:col-span-7 lg:col-start-6" style={`--accent:${c}`}>
          <Content />
        </div>
      </div>
    </article>

    <section class="border-t border-white/10" aria-labelledby="cta-title">
      <div class="wrap grid gap-8 py-16 md:grid-cols-12 md:items-center md:py-20">
        <div class="md:col-span-8">
          <h2 id="cta-title" class="h-section">¿Tienes un reto parecido?</h2>
          <p class="lede mt-4 max-w-[52ch]">Cuéntanos qué necesitas. Te respondemos en menos de 24 horas hábiles con preguntas concretas o una propuesta inicial.</p>
        </div>
        <div class="grid gap-3 sm:flex sm:flex-wrap md:col-span-4 md:justify-end">
          <a href={url('/#contacto')} class="btn-primary !px-6 !py-3.5 text-base">Cotiza tu proyecto</a>
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn-ghost !px-6 !py-3.5 text-base"><MessageCircle size={18} aria-hidden="true" /> WhatsApp</a>
        </div>
      </div>
    </section>

    <nav aria-label="Siguiente proyecto" class="border-t border-white/10">
      <a href={url(`/proyectos/${next.slug}/`)} class="group/cover wrap grid items-center gap-8 py-14 md:grid-cols-12 md:py-20">
        <div class="md:col-span-7">
          <p class="text-niebla">Siguiente proyecto</p>
          <p class="display mt-2 text-[clamp(2rem,5vw,4rem)] leading-none transition-colors group-hover/cover:text-azul-luz">{next.name}</p>
          <p class="mt-3 text-niebla-2">{next.kind}</p>
        </div>
        <div class="relative aspect-[16/8] overflow-hidden rounded-lg border border-white/10 md:col-span-5" style={`view-transition-name: cover-${next.slug}`}>
          <ProjectCover p={next} />
          <span class="absolute bottom-4 right-4 grid h-12 w-12 place-items-center rounded-full bg-azul text-white transition-transform duration-300 group-hover/cover:translate-x-1" aria-hidden="true"><ArrowRight size={20} /></span>
        </div>
      </a>
    </nav>
  </main>
  <Footer />
</Base>
