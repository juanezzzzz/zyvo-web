---
import { Image } from 'astro:assets';
import zy from '../assets/zy-robot.webp';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="Página no encontrada | Zyvo Solutions">
  <Header />
  <main id="main" class="relative isolate overflow-hidden bg-carbon pt-[4.5rem]">
    <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path class="band-path" stroke-width="30" d="M-40 842H420L560 761H700" />
      <path class="band-path opacity-40" stroke-width="30" d="M820 692L1080 542H1500" />
    </svg>
    <div class="wrap grid min-h-[calc(100svh-4.5rem)] items-center gap-10 py-16 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="text-niebla-2">Error 404</p>
        <h1 class="display mt-3 text-[clamp(2.5rem,6vw,5rem)] leading-[1]">Esta página no existe</h1>
        <p class="lede mt-6 max-w-[46ch]">Puede que el enlace esté mal escrito o que la página se haya movido. Desde el inicio encuentras todo.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/" class="btn-primary !px-6 !py-3.5 text-base">Ir al inicio</a>
          <a href="/#proyectos" class="btn-ghost !px-6 !py-3.5 text-base">Ver proyectos</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <Image src={zy} alt="" widths={[320, 520]} sizes="(min-width: 768px) 30vw, 50vw" class="mx-auto h-auto w-1/2 -rotate-6 opacity-90 drop-shadow-[0_30px_40px_rgba(0,0,0,.6)] md:w-2/3" />
      </div>
    </div>
  </main>
</Base>
