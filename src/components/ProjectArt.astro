---
// Ilustraciones propias de cada caso (no son capturas). Paleta de marca.
interface Props { art: 'agro' | 'sst' | 'vial' | 'api' }
const { art } = Astro.props;
const N = '#0E1218', A = '#1B212B', G = '#2A3240', B = '#4766F5', L = '#7B93FF', M = '#F5F4EF', F = '#8A93A3', S = '#2BD67B', Y = '#F5B544', R = '#F0675E';
const sans = "font-family:'Archivo Variable',Archivo,sans-serif";
const mono = "font-family:'JetBrains Mono Variable','JetBrains Mono',monospace";
const bars = [6,14,22,10,26,18,30,12,24,16,8,20,28,14,6,18,24,10];
---
<svg viewBox="0 0 480 360" class="block h-auto w-full" role="img" aria-label={{agro:'Ilustración: chat de AgroIA con nota de voz', sst:'Ilustración: juego de dotación de EPP', vial:'Ilustración: mapa de Yopal con zonas de riesgo', api:'Ilustración: diagrama de servicios de Jobsy'}[art]}>
  <rect width="480" height="360" fill={N} />

  {art === 'agro' && (
    <g>
      <rect x="130" y="18" width="220" height="360" rx="28" fill={A} stroke={G} stroke-width="2" />
      <rect x="130" y="18" width="220" height="56" rx="28" fill={G} />
      <rect x="130" y="50" width="220" height="24" fill={G} />
      <circle cx="160" cy="48" r="13" fill={B} />
      <path d="M154 48l6-6 6 6-6 6z" fill={M} />
      <text x="182" y="45" fill={M} style={`${sans};font-size:13px;font-weight:700`}>AgroIA</text>
      <text x="182" y="60" fill={S} style={`${mono};font-size:9px`}>en línea</text>
      {/* nota de voz del productor */}
      <rect x="196" y="92" width="140" height="40" rx="14" fill={B} />
      <path d="M210 104v16l12-8z" fill={M} />
      {bars.map((h, i) => <rect x={230 + i * 4.6} y={112 - h / 2.4} width="2.6" height={h / 1.2} rx="1.3" fill={M} opacity={i < 11 ? 1 : 0.5} />)}
      <text x="318" y="128" fill={M} style={`${mono};font-size:8px`} text-anchor="end" opacity=".8">0:14</text>
      {/* respuesta del bot */}
      <rect x="144" y="146" width="168" height="78" rx="14" fill={G} />
      <text x="156" y="166" fill={M} style={`${sans};font-size:11px;font-weight:600`}>Listo, publiqué tu oferta:</text>
      <text x="156" y="186" fill={M} style={`${sans};font-size:11px`}>Plátano hartón · 40 bultos</text>
      <text x="156" y="202" fill={F} style={`${sans};font-size:10px`}>Paz de Ariporo · disponible hoy</text>
      <text x="300" y="217" fill={F} style={`${mono};font-size:8px`} text-anchor="end">6:42</text>
      {/* comprador */}
      <rect x="176" y="240" width="160" height="44" rx="14" fill={B} />
      <text x="188" y="258" fill={M} style={`${sans};font-size:11px`}>¿Quién vende queso</text>
      <text x="188" y="274" fill={M} style={`${sans};font-size:11px`}>cerca a Yopal?</text>
      <rect x="144" y="298" width="120" height="30" rx="12" fill={G} />
      <circle cx="162" cy="313" r="3" fill={F} /><circle cx="174" cy="313" r="3" fill={F} opacity=".7" /><circle cx="186" cy="313" r="3" fill={F} opacity=".4" />
    </g>
  )}

  {art === 'sst' && (
    <g>
      <rect x="24" y="24" width="432" height="38" rx="8" fill={A} />
      <text x="40" y="48" fill={M} style={`${mono};font-size:11px;letter-spacing:1px`}>NIVEL 2 · DOTACIÓN EPP</text>
      <text x="440" y="48" fill={Y} style={`${mono};font-size:11px;font-weight:700`} text-anchor="end">860 PTS</text>
      {/* trabajador */}
      <g transform="translate(150 84)">
        <path d="M-34 34a34 30 0 0 1 68 0z" fill={Y} />
        <rect x="-38" y="32" width="76" height="8" rx="4" fill={Y} />
        <circle cx="0" cy="58" r="24" fill="#C9A27E" />
        <rect x="-20" y="50" width="40" height="11" rx="5" fill={N} opacity=".85" />
        <path d="M-46 92q46-16 92 0v104h-92z" fill={B} />
        <rect x="-46" y="132" width="92" height="9" fill={Y} />
        <rect x="-70" y="96" width="22" height="80" rx="10" fill={B} />
        <rect x="48" y="96" width="22" height="80" rx="10" fill={B} />
        <rect x="-74" y="170" width="30" height="24" rx="8" fill={S} />
        <rect x="44" y="170" width="30" height="24" rx="8" fill={S} />
        <rect x="-40" y="196" width="34" height="56" fill={G} />
        <rect x="6" y="196" width="34" height="56" fill={G} />
        <rect x="-46" y="246" width="42" height="18" rx="6" stroke={M} stroke-dasharray="4 4" fill="none" />
        <rect x="4" y="246" width="42" height="18" rx="6" stroke={M} stroke-dasharray="4 4" fill="none" />
      </g>
      {/* checklist */}
      {[['Casco', 1], ['Gafas', 1], ['Guantes', 1], ['Chaleco', 1], ['Botas', 0]].map(([t, ok], i) => (
        <g transform={`translate(290 ${96 + i * 40})`}>
          <rect width="150" height="30" rx="8" fill={ok ? A : 'none'} stroke={ok ? 'none' : F} stroke-dasharray="4 4" />
          <text x="14" y="20" fill={ok ? M : F} style={`${sans};font-size:12px;font-weight:600`}>{t}</text>
          {ok ? <path d="M124 15l5 5 9-10" stroke={S} stroke-width="2.4" fill="none" stroke-linecap="round" /> : <text x="136" y="20" fill={F} style={`${mono};font-size:10px`} text-anchor="end">arrastra</text>}
        </g>
      ))}
      <rect x="290" y="306" width="150" height="8" rx="4" fill={G} />
      <rect x="290" y="306" width="120" height="8" rx="4" fill={S} />
      <text x="290" y="334" fill={F} style={`${mono};font-size:9px`}>4 de 5 elementos</text>
    </g>
  )}

  {art === 'vial' && (
    <g>
      <g stroke={G} stroke-width="1.2">
        {Array.from({ length: 13 }, (_, i) => <line x1={-40 + i * 44} y1="0" x2={20 + i * 44} y2="360" />)}
        {Array.from({ length: 10 }, (_, i) => <line x1="0" y1={10 + i * 40} x2="480" y2={-10 + i * 40} />)}
      </g>
      <path d="M-10 300C90 280 140 330 230 300S380 240 490 262" stroke="#2B45C9" stroke-width="14" fill="none" opacity=".75" />
      <path d="M40 0L170 360" stroke={F} stroke-width="5" opacity=".7" />
      <path d="M0 150L480 118" stroke={F} stroke-width="5" opacity=".7" />
      {[[110, 145, R], [215, 92, Y], [160, 228, R], [300, 168, Y], [365, 128, R], [250, 250, Y]].map(([x, y, c]) => (
        <g>
          <circle cx={x} cy={y} r="18" fill={c as string} opacity=".18" />
          <circle cx={x} cy={y} r="7" fill={c as string} stroke={N} stroke-width="2" />
        </g>
      ))}
      <rect x="24" y="22" width="206" height="58" rx="10" fill={A} />
      <circle cx="44" cy="42" r="6" fill={R} /><text x="58" y="46" fill={M} style={`${sans};font-size:11px`}>Zona de riesgo alto</text>
      <circle cx="44" cy="62" r="6" fill={Y} /><text x="58" y="66" fill={M} style={`${sans};font-size:11px`}>Reportado por la comunidad</text>
      <text x="456" y="340" fill={M} style={`${mono};font-size:11px;letter-spacing:1px`} text-anchor="end">YOPAL</text>
      <text x="456" y="324" fill={F} style={`${mono};font-size:9px`} text-anchor="end">río Cravo Sur</text>
    </g>
  )}

  {art === 'api' && (
    <g style={`${mono};font-size:11px`}>
      <defs><marker id="ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8z" fill={F} /></marker></defs>
      <g stroke={F} stroke-width="1.4" fill="none" marker-end="url(#ar)">
        <path d="M96 76V116" /><path d="M96 76H236V116" /><path d="M236 76H380V116" />
        <path d="M96 166V226" /><path d="M236 166V226" /><path d="M110 166L210 226" />
        <path d="M380 166V226" />
      </g>
      <rect x="56" y="36" width="364" height="40" rx="8" fill={A} stroke={G} />
      <text x="238" y="61" fill={M} text-anchor="middle">clientes · web y móvil</text>
      {[[30, 'tienda', 'Go · Beego', B], [170, 'suscripciones', 'Go · Beego', B], [314, 'red social', 'NestJS', L]].map(([x, t, s, c]) => (
        <g transform={`translate(${x} 116)`}>
          <rect width="132" height="50" rx="8" fill={c as string} />
          <text x="12" y="22" fill="#fff" style="font-weight:700">{t}</text>
          <text x="12" y="38" fill="#fff" opacity=".8" style="font-size:10px">{s}</text>
        </g>
      ))}
      <g transform="translate(30 226)">
        <rect width="272" height="66" rx="8" fill={A} stroke={G} />
        <text x="14" y="24" fill={M} style="font-weight:700">PostgreSQL</text>
        <rect x="14" y="34" width="110" height="20" rx="4" fill={G} /><text x="24" y="48" fill={M} style="font-size:10px">schema tienda</text>
        <rect x="132" y="34" width="126" height="20" rx="4" fill={G} /><text x="142" y="48" fill={M} style="font-size:10px">schema suscripciones</text>
      </g>
      <g transform="translate(314 226)">
        <rect width="132" height="66" rx="8" fill={A} stroke={G} />
        <text x="14" y="24" fill={M} style="font-weight:700">MongoDB</text>
        <text x="14" y="46" fill={F} style="font-size:10px">6 módulos · bcrypt</text>
      </g>
      <g transform="translate(30 312)">
        <rect width="150" height="26" rx="13" fill="none" stroke={S} />
        <text x="75" y="17" fill={S} text-anchor="middle" style="font-size:10px">Swagger · docs</text>
        <rect x="160" width="142" height="26" rx="13" fill="none" stroke={F} />
        <text x="231" y="17" fill={F} text-anchor="middle" style="font-size:10px">+ API Django REST</text>
      </g>
    </g>
  )}
</svg>
