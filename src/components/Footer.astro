---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-noche text-marfil">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo size={40} />
      <p class="cond mt-8 text-4xl text-niebla">{site.tagline}</p>
    </div>
    <nav aria-label="Pie de página" class="md:col-span-3 md:col-start-7">
      <ul class="grid gap-2">{[...nav, { label: 'Contacto', href: '#contacto' }].map((n) => <li><a href={n.href} class="text-niebla hover:text-marfil">{n.label}</a></li>)}</ul>
    </nav>
    <ul class="grid content-start gap-2 md:col-span-3">
      {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="text-niebla hover:text-marfil">{s.label} ↗</a></li>)}
    </ul>
  </div>
  <div class="wrap meta flex flex-wrap justify-between gap-3 border-t border-marfil/15 py-6 text-niebla">
    <span>© {year} {site.name}</span>
    <span>{site.city} · {site.coords}</span>
  </div>
</footer>
