---
import { AppWindow, Network, GraduationCap, BrainCircuit } from '@lucide/astro';
import HexBadge from './HexBadge.astro';
import { services } from '../data/site';
const icons = { web: AppWindow, api: Network, edu: GraduationCap, ai: BrainCircuit } as const;
---
<section id="servicios" class="relative bg-noche">
  <div class="wrap py-16 sm:py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="h-section lg:col-span-7">Lo que hacemos por tu empresa</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        Desde una plataforma completa hasta una integración puntual. Te decimos qué vale la pena construir y qué no.
      </p>
    </div>

    <div class="mt-10 grid border-t sm:mt-16 border-white/10 md:grid-cols-2">
      {services.map((s, i) => {
        const Icon = icons[s.icon as keyof typeof icons];
        return (
          <article class:list={['group flex flex-col gap-5 border-b border-white/10 py-9 sm:flex-row sm:gap-8 md:py-12', i % 2 === 0 ? 'md:border-r md:pr-10' : 'md:pl-10']}>
            <HexBadge size={64} class="sm:hidden" band={i % 2 === 0 ? 'bottom' : 'right'}><Icon /></HexBadge>
            <HexBadge size={76} band={i % 2 === 0 ? 'bottom' : 'right'} class="max-sm:!hidden transition-transform duration-500 group-hover:-translate-y-1">
              <Icon />
            </HexBadge>
            <div class="min-w-0">
              <h3 class="wide text-xl font-bold md:text-2xl">{s.title}</h3>
              <p class="mt-3 max-w-[44ch] text-niebla-2">{s.text}</p>
              <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-niebla" aria-label="Tecnologías">
                {s.tags.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
