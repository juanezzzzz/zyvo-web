---
import { AppWindow, Network, GraduationCap, BrainCircuit, Box, Clapperboard, ArrowRight } from '@lucide/astro';
import HexBadge from './HexBadge.astro';
import { services, audiencesLine } from '../data/site';
const icons = { web: AppWindow, api: Network, edu: GraduationCap, ai: BrainCircuit, print3d: Box, video: Clapperboard } as const;
const software = services.filter((s) => s.line === 'software');
const creativo = services.filter((s) => s.line === 'creativo');
---
<!-- La banda del hero se abre en una franja azul con el título (no en un bloque entero: el azul es acento, no fondo)
     y los servicios siguen en oscuro, en dos columnas hermanas: software a la medida y estudio creativo. -->
<section id="servicios" class="relative isolate bg-noche" aria-labelledby="svc-title">
  <div class="svc-plate relative isolate overflow-hidden bg-banda text-white">
    <!-- Panal grabado en el azul, apenas visible -->
    <div class="hexgrid pointer-events-none absolute inset-0 -z-10 opacity-[.22] mix-blend-soft-light [mask-image:linear-gradient(to_bottom,black,transparent_80%)]" aria-hidden="true"></div>
    <div class="wrap grid gap-6 pb-[calc(clamp(37px,5vw,73px)+2.5rem)] pt-16 sm:pt-20 md:pt-24 lg:grid-cols-12 lg:items-end">
      <h2 id="svc-title" class="h-chapter lg:col-span-7">Lo que hacemos</h2>
      <p class="max-w-[46ch] text-lg leading-relaxed text-white/90 lg:col-span-5 lg:justify-self-end">
        Software a la medida para tu negocio y un estudio creativo para contarlo. Te decimos con sinceridad qué vale la pena hacer y qué no.
      </p>
    </div>
    <!-- Salida: la franja termina en el escalón a 30° de la banda -->
    <svg class="absolute inset-x-0 -bottom-px h-[clamp(37px,calc(5vw+1px),73px)] w-full" viewBox="0 0 1440 72" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path d="M-40 72V44H520L568.5 16H1480V72Z" fill="var(--color-noche)" />
    </svg>
  </div>

  <div class="wrap grid gap-14 pb-16 pt-12 sm:pb-20 md:pb-24 md:pt-16 lg:grid-cols-12 lg:gap-x-16">
    <!-- Software a la medida -->
    <div class="min-w-0 lg:col-span-7">
      <h3 class="wide flex items-center gap-3 text-xl font-bold text-marfil">
        <span class="h-4 w-1.5 -skew-y-[30deg] bg-banda" aria-hidden="true"></span>Software a la medida
      </h3>
      <ul class="mt-5 border-t border-white/10">
        {software.map((s) => {
          const Icon = icons[s.icon as keyof typeof icons];
          return (
            <li class="svc-item flex gap-5 border-b border-white/10 py-7 sm:gap-6">
              <HexBadge size={56} band="none" flat><Icon /></HexBadge>
              <div class="min-w-0">
                <h4 class="wide text-lg font-bold text-marfil sm:text-xl">{s.title}</h4>
                <p class="mt-2 max-w-[52ch] text-niebla-2">{s.text}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Estudio creativo: mismo lenguaje que la columna de software; abajo, para quién trabajamos -->
    <div class="flex min-w-0 flex-col lg:col-span-5">
      <h3 class="wide flex items-center gap-3 text-xl font-bold text-marfil">
        <span class="h-4 w-1.5 -skew-y-[30deg] bg-banda" aria-hidden="true"></span>Estudio creativo
      </h3>
      <ul class="mt-5 border-t border-white/10">
        {creativo.map((s) => {
          const Icon = icons[s.icon as keyof typeof icons];
          return (
            <li class="svc-item flex gap-5 border-b border-white/10 py-7 sm:gap-6">
              <HexBadge size={56} band="none" flat><Icon /></HexBadge>
              <div class="min-w-0">
                <h4 class="wide text-lg font-bold text-marfil sm:text-xl">{s.title}</h4>
                <p class="mt-2 text-niebla-2">{s.text}</p>
              </div>
            </li>
          );
        })}
      </ul>
      <a href="#estudio" class="mt-6 inline-flex min-h-11 items-center gap-1.5 self-start font-semibold text-azul-luz underline decoration-azul-luz/40 underline-offset-4 transition-colors hover:text-marfil hover:decoration-marfil">
        Ver el estudio <ArrowRight size={16} aria-hidden="true" />
      </a>

      <div class="svc-item mt-10 border-t border-white/10 pt-6 lg:mt-auto">
        <p class="text-sm font-semibold text-marfil">Para quién trabajamos</p>
        <p class="mt-2 max-w-[44ch] text-niebla-2">{audiencesLine}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reduced } from '../scripts/motion';

  // La franja nace como una banda delgada con su escalón a 30° y se abre con el scroll hasta su alto.
  // Solo se aplica con JS y lo controla el scroll; sin JS la franja se ve completa.
  const plate = document.querySelector<HTMLElement>('.svc-plate')!;
  const band = 'polygon(0% 34%, 46% 34%, 54% 22%, 100% 22%, 100% 32%, 54% 32%, 46% 44%, 0% 44%)';
  const full = 'polygon(0% 0%, 46% 0%, 54% 0%, 100% 0%, 100% 100%, 54% 100%, 46% 100%, 0% 100%)';
  gsap.fromTo(plate, { clipPath: band }, {
    clipPath: full,
    ease: 'power2.inOut',
    scrollTrigger: { trigger: plate, start: 'top 95%', end: 'top 35%', scrub: reduced ? true : 0.6 },
    onComplete: () => { plate.style.clipPath = ''; },
  });
  // Los servicios entran en escalera cuando la franja ya se abrió
  if (!reduced) {
    gsap.fromTo(document.querySelectorAll('#servicios .svc-item'), { y: 32, opacity: 0 }, {
      y: 0, opacity: 1, stagger: 0.06, ease: 'power2.out',
      scrollTrigger: { trigger: '#servicios', start: 'top 45%', end: 'top 5%', scrub: 0.6 },
    });
  }
</script>
