---
import { url } from '../lib/url';
import { ArrowRight } from '@lucide/astro';
import { audiences } from '../data/site';
---
<section id="para-quien" class="relative bg-noche" aria-labelledby="para-quien-title">
  <div class="wrap py-16 sm:py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="para-quien-title" class="h-section lg:col-span-7">Para quién trabajamos</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        No vendemos paquetes. Partimos de lo que hace tu organización y construimos lo que le hace falta.
      </p>
    </div>

    <ul class="mt-14 border-b border-white/10">
      {audiences.map((a) => (
        <li class="aud group relative isolate grid gap-3 border-t border-white/10 py-8 md:grid-cols-12 md:items-baseline md:gap-8 md:py-10">
          <!-- Al pasar el mouse, la banda barre la fila con su borde a 30° -->
          <span class="aud-sweep absolute inset-y-0 -left-4 -right-4 -z-10 bg-banda sm:-left-6 sm:-right-6" aria-hidden="true"></span>
          <h3 class="wide text-[clamp(1.5rem,2.6vw,2.1rem)] font-bold leading-tight transition-transform duration-500 ease-out group-hover:translate-x-2 md:col-span-5">{a.who}</h3>
          <p class="max-w-[46ch] text-niebla-2 transition-colors duration-300 group-hover:text-white/90 md:col-span-4">{a.what}</p>
          <a href={url(`/proyectos/${a.case.slug}/`)} class="inline-flex items-center gap-1.5 justify-self-start rounded-md py-1 text-sm font-semibold text-azul-luz transition-colors after:absolute after:inset-0 group-hover:text-white md:col-span-3 md:justify-self-end">
            Ver el caso {a.case.label}<ArrowRight size={16} aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Barrido de la banda: entra desde la izquierda con el borde inclinado a 30° */
  .aud-sweep {
    clip-path: polygon(0 0, 0 0, -4rem 100%, -4rem 100%);
    transition: clip-path .55s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .aud:hover .aud-sweep, .aud:focus-within .aud-sweep {
      clip-path: polygon(0 0, calc(100% + 4rem) 0, 100% 100%, -4rem 100%);
    }
  }
  .aud:focus-within .aud-sweep { clip-path: polygon(0 0, calc(100% + 4rem) 0, 100% 100%, -4rem 100%); }
  .aud:hover + .aud, .aud:focus-within + .aud { border-top-color: transparent; }
  @media (prefers-reduced-motion: reduce) {
    .aud-sweep { transition: opacity .25s; clip-path: none; opacity: 0; }
    .aud:hover .aud-sweep, .aud:focus-within .aud-sweep { opacity: 1; }
  }
</style>
