---
import { url } from '../lib/url';
import { ArrowRight } from '@lucide/astro';
import { audiences } from '../data/site';
---
<section id="para-quien" class="relative border-t border-white/10 bg-noche" aria-labelledby="para-quien-title">
  <div class="wrap py-16 sm:py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="para-quien-title" class="h-section lg:col-span-7">Para quién trabajamos</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        No vendemos paquetes. Partimos de lo que hace tu organización y construimos lo que le hace falta.
      </p>
    </div>

    <ul class="mt-14 border-b border-white/10">
      {audiences.map((a) => (
        <li class="group relative grid gap-3 border-t border-white/10 py-8 md:grid-cols-12 md:items-baseline md:gap-8 md:py-10">
          <span class="absolute left-0 top-0 h-0.5 w-0 bg-banda transition-[width] duration-500 ease-out group-hover:w-full" aria-hidden="true"></span>
          <h3 class="wide text-[clamp(1.5rem,2.6vw,2.1rem)] font-bold leading-tight md:col-span-5">{a.who}</h3>
          <p class="max-w-[46ch] text-niebla-2 md:col-span-4">{a.what}</p>
          <a href={url(`/proyectos/${a.case.slug}/`)} class="inline-flex items-center gap-1.5 justify-self-start rounded-md py-1 text-sm font-semibold text-azul-luz transition-colors after:absolute after:inset-0 hover:text-marfil md:col-span-3 md:justify-self-end">
            Ver el caso {a.case.label}<ArrowRight size={16} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
