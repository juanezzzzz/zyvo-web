---
import { Mail } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import ContactForm from './ContactForm';
import { site } from '../data/site';
import { url } from '../lib/url';
import { getImage } from 'astro:assets';
import zyCelebra from '../assets/zy-celebra.png';
import { getProjects } from '../lib/get-projects';
// Zy celebrando, para cuando el mensaje sale (optimizado aquí: la isla de React solo recibe la ruta)
const zy = await getImage({ src: zyCelebra, width: 320, format: 'webp' });
// Una voz de cliente justo antes de escribirnos: el primer testimonio con nombre
const voice = (await getProjects()).find((p) => p.testimonial && !p.testimonial.reported);

---
<section id="contacto" class="relative isolate overflow-hidden bg-marfil text-noche [color-scheme:light]">
  <div class="wrap sec-major relative z-10 grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-5">
      <h2 class="h-chapter">Cuéntanos qué quieres construir</h2>
      <p class="mt-6 max-w-[44ch] text-lg text-tinta-2">Solemos responder en menos de 24 horas hábiles, con preguntas concretas o una propuesta inicial.</p>
      {voice?.testimonial && (
        <figure class="mt-8 max-w-md border-t border-noche/15 pt-6">
          <blockquote class="flex gap-3 text-lg font-semibold leading-snug text-noche">
            <span class="mt-[0.45em] h-3.5 w-1.5 shrink-0 -skew-y-[30deg] bg-banda" aria-hidden="true"></span>
            <p>“{voice.testimonial.short ?? voice.testimonial.quote}”</p>
          </blockquote>
          <figcaption class="mt-2 pl-[1.125rem] text-sm text-tinta-2">{voice.testimonial.author}, {voice.testimonial.role.charAt(0).toLowerCase() + voice.testimonial.role.slice(1)}</figcaption>
        </figure>
      )}

      <!-- WhatsApp y correo como botones: el número y la dirección no aparecen escritos en la página (anti-scraping) -->
      <div class="mt-8 grid gap-3 sm:max-w-md sm:grid-cols-2">
        <a href="#contacto" data-contact="wa" data-contact-text="Hola Zyvo, quiero hablar de un proyecto." target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" class="btn !justify-start gap-3 bg-whatsapp !px-4 !py-3.5 text-base text-white hover:bg-whatsapp-hondo hover:shadow-[0_10px_28px_-10px_rgba(15,133,69,.9)]">
          <WhatsAppIcon size={20} /> WhatsApp
        </a>
        <a href="#contacto" data-contact="mail" data-contact-text="Quiero hablar de un proyecto" aria-label="Envíanos un correo" class="btn !justify-start gap-3 bg-noche !px-4 !py-3.5 text-base text-marfil hover:bg-acero hover:shadow-[0_10px_28px_-12px_rgba(14,18,24,.7)]">
          <Mail size={20} aria-hidden="true" /> Correo
        </a>
      </div>
      <p class="mt-4 max-w-md text-sm text-tinta-2">Al escribirnos aceptas que usemos tus datos para responderte, según nuestra <a href={url('/privacidad/')} class="font-semibold text-noche underline decoration-azul decoration-2 underline-offset-2 hover:text-azul">política de privacidad</a>.</p>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ContactForm client:visible endpoint={site.formEndpoint} successImg={zy.src} />
    </div>
  </div>
</section>
