---
import { MessageCircle, Mail, MapPin } from '@lucide/astro';
import ContactForm from './ContactForm';
import { site } from '../data/site';
import { url } from '../lib/url';

---
<section id="contacto" class="relative isolate overflow-hidden bg-marfil text-noche [color-scheme:light]">
  <div class="wrap relative z-10 grid gap-14 py-16 sm:py-24 md:py-32 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-5">
      <h2 class="h-section">Cuéntanos qué quieres construir</h2>
      <p class="mt-6 max-w-[44ch] text-lg text-tinta-2">Te respondemos en menos de 24 horas hábiles con preguntas concretas o una propuesta inicial.</p>

      <!-- WhatsApp y correo como botones: el número y la dirección no aparecen escritos en la página (anti-scraping) -->
      <div class="mt-10 grid gap-3 sm:mt-12 sm:max-w-md sm:grid-cols-2">
        <a href="#contacto" data-contact="wa" data-contact-text="Hola Zyvo, quiero hablar de un proyecto." target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" class="btn !justify-start gap-3 bg-[#0F8545] !px-4 !py-3.5 text-base text-white hover:bg-[#0B6B38] hover:shadow-[0_10px_28px_-10px_rgba(15,133,69,.9)]">
          <MessageCircle size={20} aria-hidden="true" /> WhatsApp
        </a>
        <a href="#contacto" data-contact="mail" data-contact-text="Quiero hablar de un proyecto" aria-label="Envíanos un correo" class="btn !justify-start gap-3 bg-noche !px-4 !py-3.5 text-base text-marfil hover:bg-acero hover:shadow-[0_10px_28px_-12px_rgba(14,18,24,.7)]">
          <Mail size={20} aria-hidden="true" /> Correo
        </a>
      </div>
      <p class="mt-4 max-w-md text-sm text-tinta-2">Al escribirnos aceptas que usemos tus datos para responderte, según nuestra <a href={url('/privacidad/')} class="font-semibold text-noche underline decoration-azul decoration-2 underline-offset-2 hover:text-azul">política de privacidad</a>.</p>
      <p class="mt-8 flex items-center gap-3 text-noche/75">
        <span class="hex-clip grid h-10 w-[2.2rem] shrink-0 place-items-center bg-noche text-marfil" aria-hidden="true"><MapPin size={16} /></span>
        <span><span class="sr-only">Ubicación: </span><span class="font-semibold text-noche">{site.city}</span></span>
      </p>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ContactForm client:visible endpoint={site.formEndpoint} />
    </div>
  </div>
</section>
