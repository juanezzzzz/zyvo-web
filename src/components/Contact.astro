---
import { MessageCircle, Mail, MapPin } from '@lucide/astro';
import ContactForm from './ContactForm';
import { site } from '../data/site';
const channels = [
  { label: 'WhatsApp', value: site.whatsappLabel, href: `https://wa.me/${site.whatsapp}`, icon: MessageCircle, external: true },
  { label: 'Correo', value: site.email, href: `mailto:${site.email}`, icon: Mail },
  { label: 'Ubicación', value: site.city, icon: MapPin },
];
---
<section id="contacto" class="relative isolate overflow-hidden bg-marfil text-noche [color-scheme:light]">
  <div class="wrap relative z-10 grid gap-14 py-16 sm:py-24 md:py-32 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-5">
      <h2 class="h-section">Cuéntanos qué quieres construir</h2>
      <p class="mt-6 max-w-[44ch] text-lg text-tinta-2">Te respondemos en menos de 24 horas hábiles con preguntas concretas o una propuesta inicial.</p>

      <ul class="mt-10 grid gap-4 sm:mt-12 sm:gap-6">
        {channels.map((c) => (
          <li class="flex items-center gap-4">
            <span class="hex-clip grid h-12 w-[2.6rem] shrink-0 place-items-center bg-noche text-marfil" aria-hidden="true"><c.icon size={18} /></span>
            <span class="min-w-0">
              <span class="block text-sm text-noche/75">{c.label}</span>
              {c.href ? (
                <a class="inline-flex min-h-11 items-center font-semibold underline-offset-4 hover:text-azul-prof hover:underline" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>{c.value}</a>
              ) : (
                <span class="font-semibold">{c.value}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ContactForm client:visible endpoint={site.formEndpoint} whatsapp={site.whatsapp} />
    </div>
  </div>
</section>
