---
import { getProjects } from '../lib/get-projects';
const projects = await getProjects();
import ProjectShowcase from './ProjectShowcase';
---
<section id="proyectos" class="relative border-t border-white/10 bg-carbon">
  <div class="wrap py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="h-section lg:col-span-7">Trabajo real, en producción</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        Agro, educación, seguridad vial y backend. Cada proyecto resolvió un problema concreto de alguien de aquí.
      </p>
    </div>
    <ProjectShowcase client:visible projects={projects} />
  </div>
</section>
