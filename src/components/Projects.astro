---
import { getProjects } from '../lib/get-projects';
const projects = await getProjects();
import ProjectShowcase from './ProjectShowcase';
---
<section id="proyectos" class="relative isolate overflow-hidden bg-carbon">
  <span class="glow -right-40 top-1/3 h-[28rem] w-[28rem] bg-azul/35" aria-hidden="true"></span>
  <span class="glow -left-40 bottom-10 h-80 w-80 bg-senal/15" aria-hidden="true"></span>
  <div class="wrap relative z-10 py-16 sm:py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="h-section lg:col-span-7">Trabajo real, en producción</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        Agro, educación, seguridad vial y comercio. Cada proyecto resolvió un problema concreto de alguien de aquí.
      </p>
    </div>
    <ProjectShowcase client:visible projects={projects} />
  </div>
</section>
