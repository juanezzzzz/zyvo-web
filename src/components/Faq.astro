---
import { Plus } from '@lucide/astro';
import { faq } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section id="preguntas" class="relative bg-carbon" aria-labelledby="faq-title">
  <div class="wrap grid gap-10 py-16 sm:py-24 md:py-32 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-4">
      <h2 id="faq-title" class="h-section">Preguntas frecuentes</h2>
      <p class="lede mt-5 max-w-[34ch]">Lo que casi todos nos preguntan antes de empezar. ¿Tienes otra duda? <a href="#contacto" class="text-marfil underline decoration-azul decoration-2 underline-offset-4 hover:text-azul-luz">Escríbenos</a>.</p>
    </div>
    <div class="border-t border-white/10 lg:col-span-7 lg:col-start-6">
      {faq.map((f, i) => (
        <details class="faq group border-b border-white/10" open={i === 0}>
          <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden">
            <span class="wide text-lg font-bold leading-snug transition-colors duration-200 group-hover:text-azul-luz sm:text-xl">{f.q}</span>
            <span class="faq-icon grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/15 text-niebla-2 transition-[rotate,background-color,color,border-color] duration-300 group-hover:border-azul-luz group-hover:text-marfil group-open:rotate-45 group-open:border-azul group-open:bg-azul group-open:text-white" aria-hidden="true">
              <Plus size={18} />
            </span>
          </summary>
          <p class="faq-a max-w-[60ch] pb-6 pr-14 text-niebla-2">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  /* Mientras se cierra, el ícono vuelve a "+" de inmediato (el <details> sigue abierto hasta terminar) */
  .faq[data-closing] .faq-icon { rotate: none; border-color: rgb(255 255 255 / .15); background-color: transparent; color: var(--color-niebla-2); }
</style>

<script>
  // Apertura y cierre suaves en todos los navegadores (Chrome, Safari, Firefox): se anima la altura del <details>.
  // Sin JS, o con "reducir movimiento", el <details> nativo sigue funcionando; ahí la respuesta solo aparece con un fundido.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

  document.querySelectorAll<HTMLDetailsElement>('details.faq').forEach((d) => {
    const summary = d.querySelector('summary')!;
    const answer = d.querySelector<HTMLElement>('.faq-a')!;
    let anim: Animation | null = null;
    let wantOpen = d.open;
    d.addEventListener('toggle', () => { if (!anim) wantOpen = d.open; });

    summary.addEventListener('click', (e) => {
      if (reduced) {
        if (!d.open) answer.animate({ opacity: [0, 1] }, { duration: 250, easing: 'ease-out' });
        return;
      }
      e.preventDefault();
      const from = d.offsetHeight;
      anim?.cancel();
      wantOpen = !wantOpen;
      d.toggleAttribute('data-closing', !wantOpen);
      if (wantOpen) d.open = true;
      const to = wantOpen ? d.offsetHeight : summary.offsetHeight + parseFloat(getComputedStyle(d).borderBottomWidth);
      d.style.overflow = 'hidden';
      const a = d.animate({ height: [`${from}px`, `${to}px`] }, { duration: 350, easing: ease });
      anim = a;
      a.onfinish = () => {
        if (!wantOpen) d.open = false;
        d.removeAttribute('data-closing');
        d.style.overflow = '';
        anim = null;
      };
      a.oncancel = () => { if (anim === a) anim = null; };
    });
  });
</script>
