---
import { ArrowUp } from '@lucide/astro';
---
<!-- Volver arriba: aparece después de bajar un poco más de una pantalla, encima del botón de WhatsApp -->
<button
  id="to-top"
  type="button"
  data-show="false"
  tabindex="-1"
  class="fixed bottom-[calc(max(1rem,env(safe-area-inset-bottom))+4.25rem)] right-4 z-40 grid h-12 w-12 place-items-center rounded-full border border-white/20 bg-noche/70 text-marfil shadow-[0_12px_30px_-8px_rgba(0,0,0,.7)] backdrop-blur-xl transition-[opacity,translate,background-color,border-color] duration-300 hover:border-azul-luz hover:bg-azul data-[show=false]:pointer-events-none data-[show=false]:translate-y-3 data-[show=false]:opacity-0 sm:right-6 sm:h-14 sm:w-14"
  aria-label="Volver arriba"
>
  <ArrowUp size={22} aria-hidden="true" />
</button>

<script>
  import { lenis, reduced } from '../scripts/motion';
  const btn = document.getElementById('to-top') as HTMLButtonElement;
  const update = () => {
    const show = window.scrollY > window.innerHeight * 1.2;
    btn.dataset.show = String(show);
    btn.tabIndex = show ? 0 : -1;
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
  btn.addEventListener('click', () => {
    if (lenis) lenis.scrollTo(0, { duration: 1.1 });
    else window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    // El foco vuelve al inicio para quien navega con teclado
    document.querySelector<HTMLElement>('#top-bar a')?.focus({ preventScroll: true });
  });
</script>
