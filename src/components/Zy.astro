---
// Mascota Zy (versión plana). mood: neutral | feliz | procesando. wave: brazo arriba.
interface Props { mood?: 'neutral' | 'feliz' | 'procesando'; wave?: boolean; class?: string }
const { mood = 'neutral', wave = false, class: cls = '' } = Astro.props;
const id = 'zy' + Math.random().toString(36).slice(2, 8);
const W = '#F5F4EF', B = '#4766F5', F = '#151A22', BODY = '#2A3240', J = '#1B212B', E = '#3A4456', EYE = '#EAF0FF';
---
<svg viewBox="0 0 200 300" class={cls} role="img" aria-label="Zy, la mascota de Zyvo">
  <defs><clipPath id={id}><polygon points="100,4 183,52 183,148 100,196 17,148 17,52" /></clipPath></defs>
  <rect x="90" y="112" width="20" height="28" rx="3" fill={J} />
  <polygon fill={BODY} stroke={E} stroke-width="2" stroke-linejoin="round" points="62,138 138,138 148,158 140,214 60,214 52,158" />
  <g fill={BODY} stroke={E} stroke-width="2">
    <rect x="70" y="216" width="24" height="44" rx="5" /><rect x="106" y="216" width="24" height="44" rx="5" />
    <path d="M62 258h36l3 14H58z" /><path d="M102 258h36l4 14H99z" />
  </g>
  <g transform="translate(88 154) scale(.12)">
    <path fill={W} stroke={W} stroke-width="8" stroke-linejoin="round" d="M22.06 88V55L100 10L177.94 55V88L100 46ZM177.94 112V145L100 190L22.06 145V112L100 154Z" />
    <path clip-path={`url(#${id})`} fill={B} d="M10 102L64 79C80 72 88 93 100 100C112 93 125 76 149.4 69.6L190 52V106L136.1 122C120 128 112 107 100 100C88 107 75 124 50.6 130.4L10 147Z" />
  </g>
  <g fill={BODY} stroke={E} stroke-width="2">
    <g transform={mood === 'procesando' ? 'rotate(30 45 150)' : ''}><rect x="34" y="144" width="22" height="58" rx="7" /><rect x="36" y="200" width="18" height="16" rx="5" fill={J} /></g>
    <g transform={wave ? 'rotate(-150 155 150)' : mood === 'procesando' ? 'rotate(-30 155 150)' : ''}><rect x="144" y="144" width="22" height="58" rx="7" /><rect x="146" y="200" width="18" height="16" rx="5" fill={J} /></g>
  </g>
  <g transform="translate(30 0) scale(.7)">
    <g transform="translate(100 100) scale(.94) translate(-100 -100)">
      <polygon fill={F} stroke={F} stroke-width="8" stroke-linejoin="round" points="100,10 177.94,55 177.94,145 100,190 22.06,145 22.06,55" />
      <path fill={W} stroke={W} stroke-width="8" stroke-linejoin="round" d="M22.06 88V55L100 10L177.94 55V88L100 46ZM177.94 112V145L100 190L22.06 145V112L100 154Z" />
      <path clip-path={`url(#${id})`} fill={B} d="M10 102L64 79C80 72 88 93 100 100C112 93 125 76 149.4 69.6L190 52V106L136.1 122C120 128 112 107 100 100C88 107 75 124 50.6 130.4L10 147Z" />
    </g>
  </g>
  {mood === 'neutral' && <g fill={EYE}><circle cx="70.4" cy="74.6" r="6" /><circle cx="129.6" cy="65.4" r="6" /></g>}
  {mood === 'feliz' && <path fill="none" stroke={EYE} stroke-width="3" stroke-linecap="round" d="M64.8 77.6q5.6-7 11.2 0M124 68.4q5.6-7 11.2 0" />}
  {mood === 'procesando' && <path stroke={EYE} stroke-width="3" stroke-linecap="round" d="M65.4 74.6h10M124.6 65.4h10" />}
</svg>
