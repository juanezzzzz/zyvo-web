---
import { Search, PenTool, Code, Rocket } from '@lucide/astro';
import HexBadge from './HexBadge.astro';
import { process } from '../data/site';
const icons = [Search, PenTool, Code, Rocket];
---
<section id="proceso" class="relative overflow-hidden bg-noche">
  <div class="wrap py-16 sm:py-24 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="h-section lg:col-span-7">Cómo trabajamos contigo</h2>
      <p class="lede max-w-[46ch] lg:col-span-5 lg:justify-self-end">
        Cuatro etapas, cada una con algo que puedes ver y aprobar antes de pasar a la siguiente.
      </p>
    </div>

    <div id="process-track" class="relative mt-12 lg:mt-24">
      <svg id="process-svg" class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
        <path id="process-ghost" class="band-path" stroke-width="22" style="stroke: var(--color-grafito); opacity:.6" />
        <path id="process-band" class="band-path" stroke-width="22" />
      </svg>

      <ol class="relative grid gap-12 lg:grid-cols-4 lg:gap-8">
        {process.map((s, i) => {
          const Icon = icons[i];
          return (
            <li class="step grid grid-cols-[auto_1fr] gap-x-6 lg:block" style={`--step:${process.length - 1 - i}`}>
              <div class="step-node relative z-10 lg:mb-8">
                <HexBadge size={84} band="none" lit={true}><Icon /></HexBadge>
              </div>
              <div class="min-w-0 pt-2 lg:pt-0">
                <p class="text-sm font-semibold text-azul-luz">Paso {i + 1}</p>
                <h3 class="wide mt-2 text-2xl font-bold">{s.title}</h3>
                <p class="mt-3 max-w-[34ch] text-niebla-2">{s.text}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

  </div>
</section>

<style>
  /* En escritorio, cada paso sube un escalón: la escalera de "Construye. Escala. Evoluciona." */
  @media (min-width: 1024px) {
    .step { margin-top: calc(var(--step) * 3.25rem); }
  }
</style>

<script>
  import { ScrollTrigger, reduced, whenIdle } from '../scripts/motion';

  const track = document.getElementById('process-track')!;
  const band = document.getElementById('process-band') as unknown as SVGPathElement;
  const ghost = document.getElementById('process-ghost') as unknown as SVGPathElement;
  const nodes = [...track.querySelectorAll<HTMLElement>('.step-node .hex-badge')];
  const SLOPE = Math.sqrt(3); // tramos diagonales a 30°, la geometría del hexágono
  let stops: number[] = [];
  let total = 0;

  // Traza la banda por el centro de cada hexágono: horizontal, diagonal a 30°, horizontal
  function build() {
    const box = track.getBoundingClientRect();
    const pts = nodes.map((n) => {
      const r = n.getBoundingClientRect();
      return { x: r.left - box.left + r.width / 2, y: r.top - box.top + r.height / 2 };
    });
    const vertical = Math.abs(pts[0].x - pts[pts.length - 1].x) < 2;
    const lead = vertical ? 0 : Math.min(box.left + 40, 160);
    const start = vertical ? { x: pts[0].x, y: pts[0].y - 60 } : { x: -lead, y: pts[0].y };
    const end = vertical ? { x: pts[0].x, y: box.height } : { x: box.width + lead, y: pts[pts.length - 1].y };

    const seq: { x: number; y: number }[] = [start];
    stops = [];
    pts.forEach((p, i) => {
      const a = seq[seq.length - 1];
      const rise = Math.abs(p.y - a.y);
      const dx = rise * SLOPE;
      if (i > 0 && rise > 1 && p.x - a.x > dx) {
        const mid = (a.x + p.x) / 2;
        seq.push({ x: mid - dx / 2, y: a.y }, { x: mid + dx / 2, y: p.y });
      }
      seq.push(p);
      stops.push(seq.length - 1);
    });
    seq.push(end);

    const lens = [0];
    for (let i = 1; i < seq.length; i++) lens.push(lens[i - 1] + Math.hypot(seq[i].x - seq[i - 1].x, seq[i].y - seq[i - 1].y));
    total = lens[lens.length - 1];
    stops = stops.map((s) => lens[s] / total);

    const d = 'M' + seq.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join('L');
    band.setAttribute('d', d);
    ghost.setAttribute('d', d);
    band.style.strokeDasharray = `${total}`;
  }

  function paint(progress: number) {
    band.style.strokeDashoffset = `${total * (1 - progress)}`;
    nodes.forEach((n, i) => (n.dataset.lit = String(progress >= stops[i] - 0.01)));
  }

  // La banda avanza con el scroll en todos los casos: la controla la persona, así que también
  // se mantiene con "reducir movimiento" (ahí sigue el scroll al instante, sin suavizado).
  whenIdle(() => {
    build();
    let p = 0;
    paint(0);
    ScrollTrigger.create({
      trigger: track,
      start: 'top 75%',
      end: 'bottom 55%',
      scrub: reduced ? true : 0.6,
      onUpdate: (st) => { p = st.progress; paint(p); },
      onRefresh: (st) => { build(); p = st.progress; paint(p); },
    });
    new ResizeObserver(() => ScrollTrigger.refresh()).observe(track);
  });
</script>
