---
import VideoPlayer from './VideoPlayer.astro';
// Pieza de contenido: tutorial vertical de impresión en resina (animaciones/zyvo/videos/resina-paso-a-paso)
const steps = ['Ajusta el modelo', 'Genera los soportes', 'Lamina por capas', 'Agita la resina', 'Viértela en la cubeta', 'Imprime'];
---
<section id="contenido" class="relative overflow-hidden border-t border-white/10 bg-noche" aria-labelledby="contenido-title">
  <div class="wrap grid gap-10 py-16 sm:py-24 md:py-32 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-6 lg:gap-y-10">
    <div class="min-w-0 lg:col-span-6 lg:self-end">
      <h2 id="contenido-title" class="h-section">También enseñamos cómo se hace</h2>
      <p class="lede mt-6 max-w-[50ch]">
        Además de construir software, hacemos videos cortos que explican procesos técnicos paso a paso. Este recorre una impresión en resina, del modelo a la pieza.
      </p>
    </div>

    <ol class="grid min-w-0 gap-x-8 self-start border-t border-white/10 sm:grid-cols-2 lg:col-span-6 lg:row-start-2" aria-label="Lo que muestra el video">
        {steps.map((s, i) => (
          <li class="flex items-baseline gap-4 border-b border-white/10 py-4">
            <span class="font-mono text-sm text-azul-luz">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-semibold">{s}</span>
          </li>
        ))}
    </ol>

    <div class="max-lg:row-start-2 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
      <!-- Marco de teléfono para el video vertical -->
      <div class="relative mx-auto w-full max-w-[19rem]">
        <svg class="pointer-events-none absolute -left-24 top-1/2 -z-0 w-[160%] -translate-y-1/2 opacity-70" viewBox="0 0 600 200" aria-hidden="true">
          <path class="band-path" stroke-width="18" d="M-10 170H170L230 135H380L440 100H610" />
        </svg>
        <div class="relative rounded-[2.6rem] border border-white/15 bg-[#151B24] p-2.5 shadow-[0_40px_80px_-30px_rgba(0,0,0,.8)]">
          <div class="overflow-hidden rounded-[2.1rem]">
            <VideoPlayer src="/videos/resina-paso-a-paso.mp4" poster="/videos/resina-paso-a-paso.webp" title="Imprimir en resina, del modelo a la pieza, en 6 pasos" duration={22.5} width={720} height={1280} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
