---
import PhoneVideos, { type PhoneVideo } from './PhoneVideos.astro';
// Videos propios (animaciones/zyvo/videos): reel de resina, espacio de trabajo y showreel de pantallas.
// Originales en Desktop/videos pagina zyvo; aquí van a 720p (public/videos).
const videos: PhoneVideo[] = [
  {
    kicker: 'Impresión 3D',
    title: 'De la idea a la pieza',
    text: 'Diseñamos tu idea en 3D, la imprimimos en resina y la terminamos a mano. Así nacen los llaveros con el logo de Zyvo.',
    src: '/videos/resina-reel.mp4',
    poster: '/videos/resina-reel.webp',
    alt: 'De la idea a la pieza: diseño e impresión 3D en resina',
  },
  {
    kicker: 'Detrás de cámaras',
    title: 'Detrás de cada proyecto',
    text: 'Las pantallas donde construimos el software y la impresora donde nacen las piezas, paso a paso.',
    src: '/videos/espacio-trabajo.mp4',
    poster: '/videos/espacio-trabajo.webp',
    alt: 'Detrás de cada proyecto: del código a la pieza impresa',
  },
  {
    kicker: 'Lo que hacemos',
    title: 'Software, video y 3D',
    text: 'Sistemas para negocios, videos para marcas y figuras impresas en 3D. Todo hecho a la medida.',
    src: '/videos/showreel.mp4',
    poster: '/videos/showreel.webp',
    alt: 'Todo empieza en una pantalla: software, video y 3D hechos a la medida',
  },
];
---
<section id="contenido" class="relative isolate overflow-hidden bg-noche" aria-labelledby="contenido-title">
  <span class="glow right-[8%] top-1/4 h-[26rem] w-[34rem] bg-azul/30" aria-hidden="true"></span>
  <div class="wrap relative z-10 grid gap-10 py-16 sm:py-24 md:py-32 xl:grid-cols-12 xl:items-center xl:gap-10">
    <div class="min-w-0 xl:col-span-4">
      <h2 id="contenido-title" class="h-section">Del diseño 3D a la pieza en tus manos</h2>
      <p class="lede mt-6 max-w-[46ch]">
        Diseñamos, imprimimos en resina y lo contamos en videos cortos para que veas cómo trabajamos, de la pantalla a la pieza.
      </p>
      <a href="#contacto" class="btn-primary mt-8 !px-6 !py-3.5 text-base">Cotiza tu pieza</a>
    </div>

    <!-- Desde 1280 px, a la derecha del texto -->
    <PhoneVideos videos={videos} class="xl:col-span-8 xl:max-w-none" />
  </div>
</section>
