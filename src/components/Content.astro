---
import VideoPlayer from './VideoPlayer.astro';
// Piezas de contenido propias (animaciones/zyvo/videos): making of del Zy 3D y tutorial de resina.
// Ojo con el making of: la figura de Zy está laminada, no impresa; lo impreso son los llaveros del isotipo.
const videos = [
  {
    kicker: 'Making of',
    title: 'De la pantalla a tus manos',
    text: 'Modelamos y animamos a Zy en 3D, lo preparamos para imprimir e imprimimos en resina llaveros con el logo de Zyvo.',
    src: '/videos/making-of-3d.mp4',
    poster: '/videos/making-of-3d.webp',
    alt: 'Making of: de la pantalla a tus manos, diseño e impresión 3D',
  },
  {
    kicker: 'Tutorial',
    title: 'Imprimir en resina en 6 pasos',
    text: 'Ajusta el modelo, genera los soportes, lamina por capas, agita la resina, viértela en la cubeta e imprime.',
    src: '/videos/resina-paso-a-paso.mp4',
    poster: '/videos/resina-paso-a-paso.webp',
    alt: 'Imprimir en resina, del modelo a la pieza, en 6 pasos',
  },
];
---
<section id="contenido" class="relative isolate overflow-hidden bg-noche" aria-labelledby="contenido-title">
  <span class="glow right-[8%] top-1/4 h-[26rem] w-[34rem] bg-azul/30" aria-hidden="true"></span>
  <div class="wrap relative z-10 grid gap-10 py-16 sm:py-24 md:py-32 lg:grid-cols-12 lg:items-center lg:gap-6">
    <div class="min-w-0 lg:col-span-5">
      <h2 id="contenido-title" class="h-section">Del diseño 3D a la pieza en tus manos</h2>
      <p class="lede mt-6 max-w-[46ch]">
        Modelamos, animamos e imprimimos en resina. Y lo contamos en videos cortos para que veas cómo se hace.
      </p>
      <a href="#contacto" class="btn-primary mt-8 !px-6 !py-3.5 text-base">Cotiza tu pieza</a>
    </div>

    <!-- En móvil: fila deslizable; en escritorio: dos teléfonos lado a lado -->
    <ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:col-span-7 lg:col-start-6" aria-label="Videos">
      {videos.map((v) => (
        <li class="w-[72%] shrink-0 snap-start sm:w-auto">
          <div class="glass rounded-[2.4rem] p-2">
            <div class="overflow-hidden rounded-[2rem]">
              <VideoPlayer src={v.src} poster={v.poster} title={v.alt} width={720} height={1280} />
            </div>
          </div>
          <p class="mt-5 text-sm font-semibold text-azul-luz">{v.kicker}</p>
          <h3 class="wide mt-1.5 text-lg font-bold leading-snug">{v.title}</h3>
          <p class="mt-2 text-sm text-niebla-2">{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
