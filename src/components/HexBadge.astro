---
// Insignia hexagonal de marca: marco de metal, núcleo negro, icono blanco y un tramo de banda.
// Pasa el icono como slot (ej. <Shield /> de @lucide/astro).
interface Props { size?: number; band?: 'bottom' | 'right' | 'none'; class?: string; lit?: boolean; flat?: boolean }
const { size = 88, band = 'bottom', class: cls = '', lit = true, flat = false } = Astro.props;
const id = 'hx' + Math.random().toString(36).slice(2, 8);
// Hexágono punta arriba con esquinas suaves, en un viewBox de 100x115
const outer = 'M50 2.5 94 27.9v59.2L50 112.5 6 87.1V27.9Z';
const inner = 'M50 15.5 82.7 34.4v46.2L50 99.5 17.3 80.6V34.4Z';
---
<span class={`hex-badge relative inline-grid shrink-0 place-items-center ${cls}`} style={`width:${size}px;height:${size * 1.15}px`} data-lit={lit ? 'true' : 'false'}>
  <svg viewBox="0 0 100 115" class:list={['absolute inset-0 h-full w-full', !flat && 'drop-shadow-[0_10px_18px_rgba(0,0,0,.45)]']} aria-hidden="true">
    <defs>
      <linearGradient id={`${id}m`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#F1F3F6" />
        <stop offset=".42" stop-color="#C3C9D1" />
        <stop offset=".64" stop-color="#868E9B" />
        <stop offset="1" stop-color="#DADEE4" />
      </linearGradient>
      <radialGradient id={`${id}c`} cx=".5" cy=".35" r=".75">
        <stop offset="0" stop-color="#1A1F27" />
        <stop offset="1" stop-color="#05070A" />
      </radialGradient>
      <clipPath id={`${id}k`}><path d={outer} /></clipPath>
    </defs>
    <path d={outer} fill={`url(#${id}m)`} stroke="#F4F6F9" stroke-opacity=".5" stroke-width=".8" stroke-linejoin="round" />
    <path d={inner} fill={`url(#${id}c)`} stroke="#000" stroke-opacity=".6" stroke-width="1.2" stroke-linejoin="round" />
    {band === 'bottom' && (
      <path clip-path={`url(#${id}k)`} class="hex-band" d="M0 92 30 92 46 82 100 82 100 96 50 96 34 106 0 106Z" fill="#2456E8" opacity=".92" />
    )}
    {band === 'right' && (
      <path clip-path={`url(#${id}k)`} class="hex-band" d="M74 0h26v115H74l10-20V20Z" fill="#2456E8" opacity=".85" />
    )}
  </svg>
  <span class="relative text-white" style={`width:${size * 0.36}px;height:${size * 0.36}px`}><slot /></span>
</span>

<style>
  .hex-badge :global(svg.lucide) { width: 100%; height: 100%; stroke-width: 1.6; }
  .hex-badge { transition: filter .5s var(--ease-out-expo), transform .5s var(--ease-out-expo); }
  .hex-badge[data-lit='false'] { filter: grayscale(1) brightness(.55); }
  .hex-badge .hex-band { transition: opacity .5s; }
  .hex-badge[data-lit='false'] .hex-band { opacity: 0; }
</style>
