---
import { site } from '../data/site';
// Pruebas concretas del equipo. Los valores (hablamos claro, todo a tu nombre…) viven en las preguntas frecuentes.
const proof = [
  { k: '1.er lugar', v: 'Hackathon Colombia 5.0, regional Casanare, con AgroIA' },
  { k: 'Clientes reales', v: 'negocios, comercios e instituciones de formación usan lo que construimos' },
  { k: 'En persona', v: 'estamos en Yopal y nos puedes visitar' },
];
---
<section id="equipo" class="relative isolate overflow-hidden bg-noche" aria-labelledby="equipo-title">
  <div class="wrap sec-minor grid gap-10 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-5">
      <h2 id="equipo-title" class="h-section">Somos {site.team}</h2>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <p class="lede max-w-[58ch]">
        Desarrolladores formados en el SENA y curtidos en hackathons. Construimos para empresas e instituciones de la región, hacemos el contenido del estudio creativo y compartimos lo que aprendemos con otros desarrolladores.
      </p>
      <dl class="mt-10 grid gap-8 border-t border-white/10 pt-8 sm:grid-cols-3 sm:gap-6">
        {proof.map((p) => (
          <div>
            <dt class="wide text-xl font-bold text-marfil">{p.k}</dt>
            <dd class="mt-1.5 text-niebla-2">{p.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
