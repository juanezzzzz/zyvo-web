---
import { Image } from 'astro:assets';
import zy from '../assets/zy-robot.webp';
import { site } from '../data/site';
const values = [
  { t: 'Hablamos claro', d: 'Propuestas con tiempos y costos concretos, sin letra pequeña ni jerga.' },
  { t: 'Mostramos el código', d: 'El proyecto es tuyo: repositorio, documentación y explicación de cada decisión.' },
  { t: 'Probamos todo', d: 'Pruebas automatizadas desde el primer sprint, no al final.' },
  { t: 'Estamos cerca', d: 'Somos de Casanare. Nos puedes ver en persona, no solo en videollamada.' },
];
const proof = [
  { k: '1.er lugar', v: 'Hackathon Regional Casanare, con AgroIA' },
  { k: '344 pruebas', v: 'automatizadas en un solo proyecto' },
  { k: 'Cada 2 semanas', v: 'una entrega que puedes probar' },
];
---
<section id="equipo" class="relative isolate overflow-hidden border-t border-white/10 bg-carbon">
  <div class="wrap grid items-center gap-14 py-24 md:py-32 lg:grid-cols-12">
    <div class="relative mx-auto w-full max-w-[22rem] lg:col-span-5 lg:max-w-none">
      <div class="hex-clip metal absolute inset-x-[6%] top-[14%] aspect-[1/1.15] opacity-[.07]" aria-hidden="true"></div>
      <svg class="absolute inset-x-0 bottom-[6%] -z-10 w-full" viewBox="0 0 400 120" aria-hidden="true">
        <path class="band-path" stroke-width="16" d="M-20 100H120L170 71H260L310 42H420" />
      </svg>
      <Image src={zy} alt="Zy, el robot de Zyvo: cabeza hexagonal con el isotipo y la banda azul cruzando el pecho" widths={[320, 520, 733]} sizes="(min-width: 1024px) 30vw, 70vw" class="relative mx-auto h-auto w-[62%] drop-shadow-[0_30px_40px_rgba(0,0,0,.6)]" />
    </div>

    <div class="min-w-0 lg:col-span-7">
      <h2 class="h-section">Somos {site.team}</h2>
      <p class="lede mt-6 max-w-[58ch]">
        Desarrolladores fullstack formados en el SENA y curtidos en hackathons. Construimos para empresas e instituciones de la región, y Zy es quien nos representa.
      </p>

      <dl class="mt-10 grid gap-6 border-y border-white/10 py-8 sm:grid-cols-3">
        {proof.map((p) => (
          <div>
            <dt class="wide text-xl font-bold text-marfil">{p.k}</dt>
            <dd class="mt-1 text-sm text-niebla-2">{p.v}</dd>
          </div>
        ))}
      </dl>

      <ul class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2">
        {values.map((v) => (
          <li class="relative pl-6">
            <span class="absolute left-0 top-[0.45em] h-4 w-1.5 -skew-y-[30deg] bg-banda" aria-hidden="true"></span>
            <h3 class="wide font-bold">{v.t}</h3>
            <p class="mt-1 text-niebla-2">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
