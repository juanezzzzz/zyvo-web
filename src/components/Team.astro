---
import Zy from './Zy.astro';
import { site } from '../data/site';
const facts = [
  ['Formación', 'Tecnólogos en Análisis y Desarrollo de Software del SENA'],
  ['Hackathon', '1.er lugar en el Hackathon Regional Casanare, Colombia 5.0, con apoyo de MinTIC, TEVEANDINA y la Universidad Distrital'],
  ['Stack', 'Go, NestJS, Django, FastAPI, React, Angular, Astro, PostgreSQL, MongoDB, Supabase, Docker'],
  ['Contenido', 'Compartimos lo que aprendemos en tutoriales para otros desarrolladores'],
];
---
<section id="equipo" class="relative overflow-hidden">
  <div class="wrap grid gap-14 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-7">
      <p class="meta text-tinta-2">Equipo</p>
      <h2 class="cond mt-3 text-[clamp(2.8rem,7vw,5.5rem)]">{site.team}</h2>
      <!-- ✏️ Revisen este texto: cuenten su historia real como equipo --><p class="mt-6 max-w-[54ch] text-xl leading-relaxed">
        Somos un equipo pequeño de desarrolladores fullstack de Yopal. Nos conocimos programando en el SENA y seguimos juntos porque nos gusta construir cosas que la gente de la región use de verdad.
      </p>
      <dl class="mt-12 border-b border-noche">
        {facts.map(([k, v]) => (
          <div class="grid gap-1 border-t border-noche py-4 sm:grid-cols-[140px_1fr] sm:gap-6">
            <dt class="meta pt-1 text-tinta-2">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <figure class="relative self-end md:col-span-4 md:col-start-9">
      <div class="relative aspect-[4/5] overflow-hidden bg-papel">
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
          <path fill="#4766F5" d="M0 92 L100 52 V72 L0 112Z" />
        </svg>
        <Zy wave mood="feliz" class="absolute bottom-0 left-1/2 w-[72%] -translate-x-1/2" />
      </div>
      <figcaption class="mt-3 text-sm text-tinta-2">Zy, nuestra mascota. Aparece en los tutoriales y en las apps que hacemos.</figcaption>
    </figure>
  </div>
</section>
