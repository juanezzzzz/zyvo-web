---
import { url } from '../lib/url';
import { site } from '../data/site';
const values = [
  { t: 'Hablamos claro', d: 'Propuestas con tiempos y costos concretos, sin letra pequeña ni jerga.' },
  { t: 'Todo queda a tu nombre', d: 'El proyecto es tuyo: te lo entregamos completo, con su documentación, y te explicamos cómo funciona.' },
  { t: 'Probamos todo', d: 'Revisamos que todo funcione bien mientras construimos, no al final.' },
  { t: 'Estamos cerca', d: 'Somos de Casanare. Nos puedes ver en persona, no solo en videollamada.' },
];
const proof = [
  { k: '1.er lugar', v: 'Hackathon Colombia 5.0, regional Casanare, con AgroIA' },
  { k: '5 proyectos', v: 'construidos para el agro, la educación, la movilidad y el comercio' },
  { k: 'En persona', v: 'estamos en Yopal y nos puedes visitar' },
];
---
<section id="equipo" class="relative isolate overflow-hidden border-t border-white/10 bg-carbon">
  <div class="wrap grid items-center gap-8 sm:gap-14 py-16 sm:py-24 md:py-32 lg:grid-cols-12">
    <!-- Zy, la mascota 3D oficial (render propio): saludo en bucle, sin sonido. Con «reducir movimiento» queda quieto. -->
    <figure class="relative mx-auto w-full max-w-[18rem] sm:max-w-[24rem] lg:col-span-5 lg:max-w-none">
      <div class="relative aspect-square overflow-hidden rounded-[2rem] border border-white/10 bg-[#0B0F15] shadow-[0_40px_80px_-30px_rgba(0,0,0,.8)]">
        <video id="zy-loop" class="h-full w-full object-cover" src={url('/videos/zy-saludo.mp4')} poster={url('/videos/zy-saludo.webp')} muted loop playsinline preload="metadata" width="720" height="720" aria-hidden="true"></video>
      </div>
      <figcaption class="mt-4 text-center text-sm text-niebla">Zy, el agente de Zyvo, saludando</figcaption>
    </figure>

    <div class="min-w-0 lg:col-span-7">
      <h2 class="h-section">Somos {site.team}</h2>
      <p class="lede mt-6 max-w-[58ch]">
        Desarrolladores formados en el SENA y curtidos en hackathons. Construimos para empresas e instituciones de la región y compartimos lo que aprendemos en contenido para otros desarrolladores.
      </p>

      <dl class="mt-10 grid gap-6 border-y border-white/10 py-8 sm:grid-cols-3">
        {proof.map((p) => (
          <div>
            <dt class="wide text-xl font-bold text-marfil">{p.k}</dt>
            <dd class="mt-1 text-sm text-niebla-2">{p.v}</dd>
          </div>
        ))}
      </dl>

      <ul class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2">
        {values.map((v) => (
          <li class="relative pl-6">
            <span class="absolute left-0 top-[0.45em] h-4 w-1.5 -skew-y-[30deg] bg-banda" aria-hidden="true"></span>
            <h3 class="wide font-bold">{v.t}</h3>
            <p class="mt-1 text-niebla-2">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Solo se anima si está en pantalla y el usuario no pidió reducir el movimiento
  const zy = document.getElementById('zy-loop') as HTMLVideoElement | null;
  if (zy && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => (e.isIntersecting ? zy.play().catch(() => {}) : zy.pause()), { threshold: 0.2 }).observe(zy);
  }
</script>
