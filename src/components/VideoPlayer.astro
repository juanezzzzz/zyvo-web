---
// Video sin reproducción automática: muestra la portada y solo descarga el video al pulsar el botón.
// Al reproducir uno se pausan los demás, y se pausa solo al salir de la pantalla.
// Con `preview`, antes del clic se ve un bucle corto sin sonido (solo mientras está en pantalla y si no se pidió
// reducir movimiento); al pulsar, el mismo cuadro pasa al video completo con sonido.
import { Play } from '@lucide/astro';
import { url } from '../lib/url';
interface Props { src: string; poster: string; title: string; duration?: number; width: number; height: number; class?: string; eager?: boolean; preview?: string; label?: string }
const { src, poster, title, width, height, class: cls = '', eager = false, preview, label = 'Ver video' } = Astro.props;
---
<div class={`video-player @container relative overflow-hidden bg-carbon ${cls}`} style={`aspect-ratio:${width}/${height}`} data-state={preview ? 'preview' : undefined}>
  {preview ? (
    <video class="vp-video absolute inset-0 h-full w-full object-cover" src={url(preview)} data-full={url(src)} poster={url(poster)} muted loop playsinline preload="metadata" width={width} height={height} title={title}></video>
  ) : (
    <video class="vp-video absolute inset-0 h-full w-full object-cover" src={url(src)} poster={url(poster)} preload="none" playsinline width={width} height={height} title={title}></video>
  )}
  <button type="button" class="vp-play group/vp absolute inset-0 grid place-items-end justify-items-center bg-gradient-to-t from-black/55 via-black/0 to-transparent pb-[6%] transition-[background-color] duration-300 hover:bg-black/20" aria-label={`${label}: ${title}`}>
    <span class="inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-marfil py-1.5 pl-1.5 pr-5 text-sm font-semibold text-noche shadow-[0_10px_30px_-8px_rgba(0,0,0,.7)] ring-1 ring-black/5 transition-[background-color,color,box-shadow,scale] duration-300 group-hover/vp:scale-[1.06] group-hover/vp:bg-azul group-hover/vp:text-white group-hover/vp:shadow-[0_0_0_6px_rgba(71,102,245,.35),0_14px_34px_-8px_rgba(71,102,245,.9)] @[17rem]:py-2 @[17rem]:pl-2 @[17rem]:pr-6 @[17rem]:text-base">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-azul text-white transition-colors duration-300 group-hover/vp:bg-white group-hover/vp:text-azul @[17rem]:h-10 @[17rem]:w-10"><Play size={18} fill="currentColor" class="translate-x-px" aria-hidden="true" /></span>
      {label}
    </span>
  </button>
  {eager && <link rel="preload" as="image" href={url(poster)} />}
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const players = [...document.querySelectorAll<HTMLElement>('.video-player')];
  const videos = players.map((p) => p.querySelector('video')!);
  const isPreview = (v: HTMLVideoElement) => v.closest<HTMLElement>('.video-player')!.dataset.state === 'preview';
  players.forEach((p, i) => {
    const v = videos[i];
    const btn = p.querySelector<HTMLButtonElement>('.vp-play')!;
    btn.addEventListener('click', () => {
      if (isPreview(v)) {
        // Del bucle al video completo, en el mismo cuadro
        delete p.dataset.state;
        v.src = v.dataset.full!;
        v.loop = false;
        v.muted = false;
      }
      v.controls = true;
      btn.hidden = true;
      v.play().catch(() => {});
      v.focus({ preventScroll: true });
    });
    // Un solo video con sonido a la vez (los bucles de vista previa no cuentan)
    v.addEventListener('play', () => {
      if (isPreview(v)) return;
      videos.forEach((o) => o !== v && !isPreview(o) && o.pause());
    });
  });
  // Fuera de pantalla todo se pausa; los bucles de vista previa arrancan al entrar
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    const v = e.target.querySelector('video');
    if (!v) return;
    if (isPreview(v)) {
      if (e.isIntersecting && !reduced) v.play().catch(() => {});
      else v.pause();
    } else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.25 });
  players.forEach((p) => io.observe(p));
</script>

<style>
  /* Pantalla completa: el video completo y centrado, con barras negras si hace falta (sin recortes ni zoom) */
  .vp-video:fullscreen { object-fit: contain; background: #000; }
  .vp-video:-webkit-full-screen { object-fit: contain; background: #000; }
</style>
