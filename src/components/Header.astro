---
import { MessageCircle } from '@lucide/astro';
import { url, isHome } from '../lib/url';
import { site } from '../data/site';
import Logo from './Logo.astro';
import { nav } from '../data/site';
// En el inicio los enlaces son anclas; desde otras páginas vuelven al inicio
const home = isHome(Astro.url.pathname);
const to = (h: string) => (home ? h : url(`/${h}`));
---
<header id="top-bar" style="view-transition-name: top-bar; padding-top: env(safe-area-inset-top, 0px)" class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color] duration-300 border-b border-transparent data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-noche/75 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:backdrop-saturate-150 data-[menu=true]:!border-transparent data-[menu=true]:!bg-transparent">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <a href={home ? '#inicio' : url()} class="text-marfil" aria-label="Zyvo Solutions, inicio"><Logo size={34} /></a>
    <nav aria-label="Principal" class="hidden items-center gap-1 text-sm md:flex">
      {nav.map((n) => (
        <a href={to(n.href)} data-spy={home ? n.href.slice(1) : undefined} class="relative rounded-md px-3.5 py-2 text-niebla-2 transition-colors hover:text-marfil aria-[current=true]:text-marfil">
          {n.label}
          <span class="spy-bar absolute inset-x-3.5 -bottom-px h-0.5 origin-left scale-x-0 bg-azul transition-transform duration-300"></span>
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={to('#contacto')} class="btn-primary hidden !py-2.5 sm:inline-flex">Cotiza tu proyecto</a>
      <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-md border border-white/15 bg-noche/60 md:hidden" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" class="menu-icon" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path class="l1" d="M2 5h14" /><path class="l2" d="M2 9h14" /><path class="l3" d="M2 13h14" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil: panel de vidrio que baja hasta la mitad de la pantalla; la página queda visible detrás,
     desenfocada, y tocarla cierra el menú. Va fuera del <header> para que el desenfoque no afecte a los elementos fixed. -->
<div id="menu-scrim" hidden class="menu-scrim fixed inset-0 z-40 bg-carbon/45 backdrop-blur-[3px] md:hidden" aria-hidden="true"></div>
<nav id="menu" aria-label="Menú móvil" hidden class="menu-panel fixed inset-x-0 top-0 z-40 max-h-[min(34rem,72svh)] overflow-y-auto overscroll-contain rounded-b-[1.75rem] border-b border-white/15 bg-noche/70 pt-[calc(4.5rem+env(safe-area-inset-top))] shadow-[0_30px_60px_-20px_rgba(0,0,0,.7)] backdrop-blur-2xl backdrop-saturate-150 md:hidden">
  <ul class="wrap grid pt-1">
    {nav.map((n, i) => (
      <li class="menu-item border-b border-white/10 last:border-0" style={`--i:${i}`}>
        <a href={to(n.href)} class="wide flex min-h-[3.25rem] items-center justify-between text-xl font-bold text-marfil active:text-azul-luz">
          {n.label}
          <span class="h-4 w-1 -skew-y-[30deg] bg-banda opacity-80" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
  <div class="wrap grid grid-cols-2 gap-2.5 pb-5 pt-3">
    <a href={to('#contacto')} class="btn-primary !px-3 !py-3.5">Cotiza tu proyecto</a>
    <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn-ghost !px-3 !py-3.5"><MessageCircle size={17} aria-hidden="true" /> WhatsApp</a>
  </div>
</nav>

<style>
  a[aria-current='true'] .spy-bar { transform: scaleX(1); }

  /* Hamburguesa → X */
  .menu-icon path { transition: transform .3s var(--ease-out-expo), opacity .2s; transform-origin: 9px 9px; }
  [aria-expanded='true'] .menu-icon .l1 { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .menu-icon .l2 { opacity: 0; }
  [aria-expanded='true'] .menu-icon .l3 { transform: translateY(-4px) rotate(-45deg); }

  /* El panel baja con un fundido y el fondo se oscurece; los enlaces suben solo si no se pidió reducir movimiento */
  .menu-panel:not([hidden]) { animation: menu-in .4s var(--ease-out-expo); }
  .menu-scrim:not([hidden]) { animation: scrim-in .3s ease-out; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-12px); } }
  @keyframes scrim-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .menu-panel:not([hidden]) .menu-item { animation: item-in .5s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 40ms + 60ms); }
    @keyframes item-in { from { opacity: 0; transform: translateY(14px); } }
  }
</style>

<script>
  import { lenis } from '../scripts/motion';
  const bar = document.getElementById('top-bar')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu')!;
  const scrim = document.getElementById('menu-scrim')!;

  const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
  const setMenu = (open: boolean, restoreFocus = false) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
    scrim.hidden = !open;
    // La página de fondo no se desplaza con el menú abierto
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) lenis?.stop(); else lenis?.start();
    bar.dataset.scrolled = String(open || window.scrollY > 8);
    bar.dataset.menu = String(open);
    if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (restoreFocus) btn.focus();
  };
  btn.addEventListener('click', () => setMenu(!isOpen()));
  scrim.addEventListener('click', () => setMenu(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setMenu(false, true); });
  // Si se agranda la ventana con el menú abierto, ciérralo
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && isOpen() && setMenu(false));

  const onScroll = () => { bar.dataset.scrolled = String(window.scrollY > 8 || btn.getAttribute('aria-expanded') === 'true'); };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Marca en el menú la sección que está en pantalla
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.spy === e.target.id)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((l) => { const s = document.getElementById(l.dataset.spy!); if (s) io.observe(s); });
</script>
