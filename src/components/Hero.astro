---
import { Picture } from 'astro:assets';
import datacenter from '../assets/datacenter.webp';
const headline = 'Construimos el software que tu empresa necesita.';
---
<section id="inicio" class="relative isolate overflow-hidden bg-carbon pt-[4.5rem]">
  <!-- Banda de integración: entra por la izquierda, sube a 30° y se pierde detrás de la imagen -->
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path id="hero-band" class="band-path" stroke-width="30" d="M-40 842H420L560 761H860L1080 634H1500" />
    <path class="band-path opacity-25" stroke-width="6" d="M-40 880H452L592 799H892L1112 672H1500" />
  </svg>
  <div class="hexgrid absolute inset-0 -z-20 opacity-40 [mask-image:radial-gradient(ellipse_at_80%_30%,black,transparent_65%)]" aria-hidden="true"></div>

  <div class="wrap grid min-h-[min(100svh,980px)] items-center gap-10 pb-24 pt-8 sm:pb-36 sm:pt-10 lg:grid-cols-12 lg:gap-6 lg:pb-44">
    <div class="relative z-10 min-w-0 lg:col-span-7">
      <p style="--i:0" class="hero-in mb-6 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[.03] py-1.5 pl-2 pr-4 text-sm text-niebla-2">
        <span class="h-2 w-2 rounded-full bg-senal shadow-[0_0_10px] shadow-senal"></span>
        Equipo de software en Yopal, Casanare
      </p>
      <h1 class="display text-[clamp(2rem,10.4vw,3.6rem)] leading-[1.02] lg:text-[clamp(2.5rem,5.6vw,4.6rem)]">
        {headline.split(' ').map((w, i) => (<><span class="hero-line inline-block overflow-hidden pb-[0.08em] align-bottom"><span class="inline-block" style={`--i:${i}`}>{w}</span></span>{' '}</>))}
      </h1>
      <p style="--i:1" class="hero-in lede mt-7 max-w-[54ch]">
        Páginas y sistemas web, plataformas educativas, asistentes automáticos y diseño 3D. Te explicamos cada paso en palabras sencillas, para que el proyecto sea tuyo de verdad.
      </p>
      <div style="--i:2" class="hero-in mt-8 grid gap-3 sm:mt-9 sm:flex sm:flex-wrap">
        <a href="#contacto" class="btn-primary !px-6 !py-3.5 text-base">Cotiza tu proyecto</a>
        <a href="#proyectos" class="btn-ghost !px-6 !py-3.5 text-base">Ver proyectos</a>
      </div>
    </div>

    <div class="relative min-w-0 lg:col-span-5">
      <div class="hero-img relative mx-auto w-full max-w-[560px] lg:-mr-16 lg:max-w-none">
        <Picture
          src={datacenter}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt="Insignias hexagonales de seguridad, acceso y arquitectura conectadas por la banda azul de Zyvo frente a un centro de datos"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full [mask-image:linear-gradient(to_right,transparent,black_14%,black_86%,transparent),linear-gradient(to_top,transparent,black_18%)] [mask-composite:intersect]"
        />
      </div>

      <!-- Tarjeta de avance: así ve el cliente su proyecto. Vidrio, banda de marca a 30° y pasos con hexágonos. -->
      <div class="hero-term absolute -bottom-16 left-0 hidden w-[min(100%,330px)] sm:-left-6 sm:block xl:-left-20" role="img" aria-label="Ejemplo del avance de un proyecto: diagnóstico y diseño listos, construcción en curso al 62 %">
        <div class="term-card relative overflow-hidden rounded-2xl p-px">
          <div class="relative rounded-[calc(1rem-1px)] bg-noche/[.97] px-5 pb-5 pt-4 backdrop-blur-2xl">
            <span class="pointer-events-none absolute -right-10 -top-12 h-32 w-32 rounded-full bg-azul/25 blur-2xl" aria-hidden="true"></span>

            <div class="relative flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5">
                <span class="hex-clip grid h-8 w-7 place-items-center bg-azul text-white" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h10M4 17h7" /></svg>
                </span>
                <div class="leading-tight">
                  <p class="text-[13px] font-semibold text-marfil">Tu proyecto</p>
                  <p class="text-xs text-niebla">Sistema para tu negocio</p>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-senal/12 px-2.5 py-1 text-xs font-semibold text-senal">
                <span class="live-dot relative h-1.5 w-1.5 rounded-full bg-senal"></span>En curso
              </span>
            </div>

            <!-- Avance en cuatro tramos inclinados, como la banda de la marca -->
            <div class="relative mt-5">
              <div class="flex items-baseline justify-between">
                <span class="text-xs text-niebla-2">Avance</span>
                <span class="wide text-xl font-bold text-marfil"><span class="term-pct">62</span><span class="text-sm text-niebla-2"> %</span></span>
              </div>
              <div class="mt-2 grid grid-cols-4 gap-1.5" aria-hidden="true">
                <span class="term-seg h-2 -skew-x-[30deg] rounded-[2px] bg-white/10"><i class="term-fill block h-full w-full rounded-[2px] bg-senal" style="--d:0"></i></span>
                <span class="term-seg h-2 -skew-x-[30deg] rounded-[2px] bg-white/10"><i class="term-fill block h-full w-full rounded-[2px] bg-senal" style="--d:1"></i></span>
                <span class="term-seg h-2 -skew-x-[30deg] rounded-[2px] bg-white/10"><i class="term-fill term-fill-half block h-full w-1/2 rounded-[2px] bg-azul-luz" style="--d:2"></i></span>
                <span class="term-seg h-2 -skew-x-[30deg] rounded-[2px] bg-white/10"></span>
              </div>
            </div>

            <!-- Pasos con línea de tiempo -->
            <ol class="term-steps relative mt-5 grid gap-3.5">
              <li class="term-line relative flex items-center gap-3 text-sm text-niebla-2" style="--i:0">
                <span class="hex-clip grid h-6 w-[1.35rem] shrink-0 place-items-center bg-senal text-carbon"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                Diagnóstico
              </li>
              <li class="term-line relative flex items-center gap-3 text-sm text-niebla-2" style="--i:1">
                <span class="hex-clip grid h-6 w-[1.35rem] shrink-0 place-items-center bg-senal text-carbon"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                Diseño aprobado
              </li>
              <li class="term-line relative flex items-center gap-3 text-sm font-semibold text-marfil" style="--i:2">
                <span class="term-now relative grid h-6 w-[1.35rem] shrink-0 place-items-center">
                  <span class="hex-clip absolute inset-0 bg-azul"></span>
                  <span class="relative h-1.5 w-1.5 rounded-full bg-white"></span>
                </span>
                Construyendo tu sistema
              </li>
              <li class="term-line relative flex items-center gap-3 text-sm text-niebla" style="--i:3">
                <span class="hex-clip grid h-6 w-[1.35rem] shrink-0 place-items-center bg-white/15"><span class="hex-clip h-[1.2rem] w-[1.05rem] bg-noche"></span></span>
                Listo para usar
              </li>
            </ol>

            <p class="term-line relative mt-5 flex items-center gap-2 border-t border-white/10 pt-3.5 text-xs text-niebla-2" style="--i:4">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-azul-luz" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
              Ves cada avance y lo apruebas tú
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrada del hero en CSS puro: arranca con el primer pintado y corre en la GPU (transform/opacity),
     sin esperar a que cargue el JavaScript. Con "reducir movimiento", todo entra con fundidos. */
  @keyframes hero-rise { from { transform: translateY(110%); } }
  @keyframes hero-up { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-fade { from { opacity: 0; } }
  @keyframes hero-draw { from { stroke-dashoffset: 1600; } }
  @keyframes term-in { from { opacity: 0; transform: translateX(-6px); } }
  @keyframes term-fill { from { transform: scaleX(0); } }
  @keyframes term-pulse { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(2.1); opacity: 0; } }
  @keyframes live { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  /* Borde de vidrio: degradado azul arriba a la izquierda que se desvanece */
  .term-card {
    background: linear-gradient(140deg, rgb(123 147 255 / .7), rgb(255 255 255 / .1) 38%, rgb(255 255 255 / .05) 70%, rgb(71 102 245 / .45));
    box-shadow: 0 30px 70px -25px rgb(0 0 0 / .85), 0 0 0 1px rgb(255 255 255 / .02);
  }
  /* Línea de tiempo entre los hexágonos de los pasos */
  .term-steps::before {
    content: ""; position: absolute; left: calc(1.35rem / 2 - 1px); top: .9rem; bottom: .9rem; width: 2px;
    background: linear-gradient(to bottom, var(--color-senal) 0 45%, var(--color-azul) 45% 72%, rgb(255 255 255 / .12) 72%);
  }
  .term-fill { transform-origin: left; animation: term-fill .8s var(--ease-out-expo) calc(var(--d) * 220ms + 1.4s) both; }
  .term-now::before {
    content: ""; position: absolute; inset: 0; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--color-azul-luz); animation: term-pulse 1.8s ease-out 2.4s infinite;
  }
  .live-dot { animation: live 1.6s ease-in-out infinite; }

  .hero-line > span { animation: hero-rise 1.1s var(--ease-out-expo) calc(var(--i) * 50ms + 80ms) both; }
  .hero-in { animation: hero-up .9s var(--ease-out-expo) calc(var(--i) * 80ms + 420ms) both; }
  #hero-band { stroke-dasharray: 1600; animation: hero-draw 1.8s cubic-bezier(.65, 0, .35, 1) .35s both; }
  .hero-term { animation: hero-up .8s var(--ease-out-expo) .95s both; }
  .term-line { animation: term-in .35s cubic-bezier(.33, 1, .68, 1) calc(var(--i) * 320ms + 1.25s) both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-line > span { animation: hero-fade .6s ease-out calc(var(--i) * 30ms) both; }
    .hero-in, .hero-term { animation-name: hero-fade; }
    #hero-band { animation-duration: 1.2s; }
    .term-line { animation-name: hero-fade; }
    .term-fill { animation: none; }
    .term-now::before, .live-dot { animation: none; }
  }
</style>

<script>
  import { gsap, reduced } from '../scripts/motion';

  // Profundidad al salir del hero: la imagen sube más rápido que el texto y la banda baja, como capas separadas
  if (!reduced && matchMedia('(min-width: 1024px)').matches) {
    const st = { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('.hero-img', { yPercent: -12, ease: 'none', scrollTrigger: st });
    gsap.to('#inicio > svg', { yPercent: 10, ease: 'none', scrollTrigger: st });
  }
</script>
