---
import { Image } from 'astro:assets';
import datacenter from '../assets/datacenter.webp';
const headline = 'Construimos el software que tu empresa necesita.';
---
<section id="inicio" class="relative isolate overflow-hidden bg-carbon pt-[4.5rem]">
  <!-- Banda de integración: entra por la izquierda, sube a 30° y se pierde detrás de la imagen -->
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path id="hero-band" class="band-path" stroke-width="30" d="M-40 842H420L560 761H860L1080 634H1500" />
    <path class="band-path opacity-25" stroke-width="6" d="M-40 880H452L592 799H892L1112 672H1500" />
  </svg>
  <div class="hexgrid absolute inset-0 -z-20 opacity-40 [mask-image:radial-gradient(ellipse_at_80%_30%,black,transparent_65%)]" aria-hidden="true"></div>

  <div class="wrap grid min-h-[min(100svh,980px)] items-center gap-10 pb-24 pt-8 sm:pb-36 sm:pt-10 lg:grid-cols-12 lg:gap-6 lg:pb-44">
    <div class="relative z-10 min-w-0 lg:col-span-7">
      <p class="hero-in mb-6 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[.03] py-1.5 pl-2 pr-4 text-sm text-niebla-2">
        <span class="h-2 w-2 rounded-full bg-senal shadow-[0_0_10px] shadow-senal"></span>
        Equipo de software en Yopal, Casanare
      </p>
      <h1 class="display text-[clamp(2.5rem,5.6vw,4.6rem)] leading-[1.02]">
        {headline.split(' ').map((w) => (<><span class="hero-line inline-block overflow-hidden pb-[0.08em] align-bottom"><span class="inline-block">{w}</span></span>{' '}</>))}
      </h1>
      <p class="hero-in lede mt-7 max-w-[54ch]">
        Aplicaciones web, APIs, plataformas educativas e IA aplicada. Entregamos avances cada dos semanas y te explicamos cada decisión, para que el proyecto sea tuyo de verdad.
      </p>
      <div class="hero-in mt-8 grid gap-3 sm:mt-9 sm:flex sm:flex-wrap">
        <a href="#contacto" class="btn-primary !px-6 !py-3.5 text-base">Cotiza tu proyecto</a>
        <a href="#proyectos" class="btn-ghost !px-6 !py-3.5 text-base">Ver proyectos</a>
      </div>
    </div>

    <div class="relative min-w-0 lg:col-span-5">
      <div class="hero-img relative mx-auto w-full max-w-[560px] lg:-mr-16 lg:max-w-none">
        <Image
          src={datacenter}
          alt="Insignias hexagonales de seguridad, acceso y arquitectura conectadas por la banda azul de Zyvo frente a un centro de datos"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full [mask-image:linear-gradient(to_right,transparent,black_14%,black_86%,transparent),linear-gradient(to_top,transparent,black_18%)] [mask-composite:intersect]"
        />
      </div>

      <div class="hero-term absolute -bottom-16 left-0 hidden sm:block w-[min(100%,330px)] rounded-lg border border-white/10 bg-acero/95 font-mono text-[12.5px] shadow-2xl shadow-black/60 backdrop-blur sm:-left-6 lg:-left-20" aria-label="Ejemplo de un despliegue">
        <div class="flex items-center gap-1.5 border-b border-white/10 px-3.5 py-2.5">
          <i class="h-2.5 w-2.5 rounded-full bg-grafito"></i><i class="h-2.5 w-2.5 rounded-full bg-grafito"></i><i class="h-2.5 w-2.5 rounded-full bg-grafito"></i>
          <span class="ml-2 text-[11px] text-niebla">zyvo / deploy</span>
        </div>
        <pre class="overflow-hidden px-3.5 py-3 leading-6 text-marfil"><span class="term-line block"><span class="text-azul-luz">$</span> zyvo build --sprint 4</span><span class="term-line block"><span class="text-senal">✓</span> 128 pruebas pasaron</span><span class="term-line block"><span class="text-azul-luz">$</span> zyvo deploy --prod</span><span class="term-line block"><span class="text-senal">●</span> en línea, 200 OK<span class="blink">▍</span></span></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reduced, primePath } from '../scripts/motion';

  // Un solo momento orquestado al cargar: titular, banda y terminal
  if (!reduced) {
    const band = document.getElementById('hero-band') as SVGPathElement;
    const len = primePath(band);
    document.documentElement.classList.remove('anim');
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.fromTo('.hero-line > span', { yPercent: 110 }, { yPercent: 0, duration: 1.1, stagger: 0.05 })
      .fromTo('.hero-in', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.08 }, 0.35)
      .fromTo(band, { strokeDashoffset: len }, { strokeDashoffset: 0, duration: 1.8, ease: 'power3.inOut' }, 0.3)
      .fromTo('.hero-term', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, 0.9)
      .fromTo('.term-line', { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.35, stagger: 0.32, ease: 'power2.out' }, 1.2);
  }
</script>
