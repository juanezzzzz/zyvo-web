---
import { Picture } from 'astro:assets';
import datacenter from '../assets/datacenter.webp';
const headline = 'Construimos el software que tu empresa necesita.';
---
<section id="inicio" class="relative isolate overflow-hidden bg-carbon pt-[4.5rem]">
  <!-- Banda de integración: entra por la izquierda, sube a 30° y se pierde detrás de la imagen -->
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path id="hero-band" class="band-path" stroke-width="30" d="M-40 842H420L560 761H860L1080 634H1500" />
    <path class="band-path opacity-25" stroke-width="6" d="M-40 880H452L592 799H892L1112 672H1500" />
  </svg>
  <div class="hexgrid absolute inset-0 -z-20 opacity-40 [mask-image:radial-gradient(ellipse_at_80%_30%,black,transparent_65%)]" aria-hidden="true"></div>

  <div class="wrap grid min-h-[min(100svh,980px)] items-center gap-10 pb-24 pt-8 sm:pb-36 sm:pt-10 lg:grid-cols-12 lg:gap-6 lg:pb-44">
    <div class="relative z-10 min-w-0 lg:col-span-7">
      <p style="--i:0" class="hero-in mb-6 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[.03] py-1.5 pl-2 pr-4 text-sm text-niebla-2">
        <span class="h-2 w-2 rounded-full bg-senal shadow-[0_0_10px] shadow-senal"></span>
        Equipo de software en Yopal, Casanare
      </p>
      <h1 class="display text-[clamp(2rem,10.4vw,3.6rem)] leading-[1.02] lg:text-[clamp(2.5rem,5.6vw,4.6rem)]">
        {headline.split(' ').map((w, i) => (<><span class="hero-line inline-block overflow-hidden pb-[0.08em] align-bottom"><span class="inline-block" style={`--i:${i}`}>{w}</span></span>{' '}</>))}
      </h1>
      <p style="--i:1" class="hero-in lede mt-7 max-w-[54ch]">
        Páginas y sistemas web, plataformas educativas, asistentes automáticos y diseño 3D. Te explicamos cada paso en palabras sencillas, para que el proyecto sea tuyo de verdad.
      </p>
      <div style="--i:2" class="hero-in mt-8 grid gap-3 sm:mt-9 sm:flex sm:flex-wrap">
        <a href="#contacto" class="btn-primary !px-6 !py-3.5 text-base">Cotiza tu proyecto</a>
        <a href="#proyectos" class="btn-ghost !px-6 !py-3.5 text-base">Ver proyectos</a>
      </div>
    </div>

    <div class="relative min-w-0 lg:col-span-5">
      <div class="hero-img relative mx-auto w-full max-w-[560px] lg:-mr-16 lg:max-w-none">
        <Picture
          src={datacenter}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt="Insignias hexagonales de seguridad, acceso y arquitectura conectadas por la banda azul de Zyvo frente a un centro de datos"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full [mask-image:linear-gradient(to_right,transparent,black_14%,black_86%,transparent),linear-gradient(to_top,transparent,black_18%)] [mask-composite:intersect]"
        />
      </div>

      <div class="hero-term absolute -bottom-16 left-0 hidden sm:block w-[min(100%,330px)] rounded-lg border border-white/10 bg-acero/95 font-mono text-[12.5px] shadow-2xl shadow-black/60 sm:-left-6 lg:-left-20" aria-label="Ejemplo de un despliegue">
        <div class="flex items-center gap-1.5 border-b border-white/10 px-3.5 py-2.5">
          <i class="h-2.5 w-2.5 rounded-full bg-grafito"></i><i class="h-2.5 w-2.5 rounded-full bg-grafito"></i><i class="h-2.5 w-2.5 rounded-full bg-grafito"></i>
          <span class="ml-2 text-xs text-niebla">zyvo / deploy</span>
        </div>
        <pre class="overflow-hidden px-3.5 py-3 leading-6 text-marfil"><span class="term-line block" style="--i:0"><span class="text-azul-luz">$</span> zyvo build --sprint 4</span><span class="term-line block" style="--i:1"><span class="text-senal">✓</span> 128 pruebas pasaron</span><span class="term-line block" style="--i:2"><span class="text-azul-luz">$</span> zyvo deploy --prod</span><span class="term-line block" style="--i:3"><span class="text-senal">●</span> en línea, 200 OK<span class="blink">▍</span></span></pre>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrada del hero en CSS puro: arranca con el primer pintado y corre en la GPU (transform/opacity),
     sin esperar a que cargue el JavaScript. Con "reducir movimiento", todo entra con fundidos. */
  @keyframes hero-rise { from { transform: translateY(110%); } }
  @keyframes hero-up { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-fade { from { opacity: 0; } }
  @keyframes hero-draw { from { stroke-dashoffset: 1600; } }
  @keyframes term-in { from { opacity: 0; transform: translateX(-6px); } }
  .hero-line > span { animation: hero-rise 1.1s var(--ease-out-expo) calc(var(--i) * 50ms + 80ms) both; }
  .hero-in { animation: hero-up .9s var(--ease-out-expo) calc(var(--i) * 80ms + 420ms) both; }
  #hero-band { stroke-dasharray: 1600; animation: hero-draw 1.8s cubic-bezier(.65, 0, .35, 1) .35s both; }
  .hero-term { animation: hero-up .8s var(--ease-out-expo) .95s both; }
  .term-line { animation: term-in .35s cubic-bezier(.33, 1, .68, 1) calc(var(--i) * 320ms + 1.25s) both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-line > span { animation: hero-fade .6s ease-out calc(var(--i) * 30ms) both; }
    .hero-in, .hero-term { animation-name: hero-fade; }
    #hero-band { animation-duration: 1.2s; }
    .term-line { animation-name: hero-fade; }
  }
</style>

<script>
  import { gsap, reduced } from '../scripts/motion';

  // Profundidad al salir del hero: la imagen sube más rápido que el texto y la banda baja, como capas separadas
  if (!reduced && matchMedia('(min-width: 1024px)').matches) {
    const st = { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('.hero-img', { yPercent: -12, ease: 'none', scrollTrigger: st });
    gsap.to('#inicio > svg', { yPercent: 10, ease: 'none', scrollTrigger: st });
  }
</script>
